# Win's VPN root-owned deployment defaults template
#
# Copy public/non-secret values to /root/winsvpn-defaults.env. Inject credentials
# separately as /root/winsvpn-secrets.env. Both files must be root-owned mode
# 600. Never ship either populated file inside an app or commit it to Git.

# ---------------------------------------------------------------------------
# Shared server bootstrap
# ---------------------------------------------------------------------------
# Control host only. Never copy the control public IP into a data-plane preseed.
# Data planes use HUB_API_BASE plus an outbound management tunnel.
IONOS_HUB_IP=
WINS_HUB_IP=
HUB_DOMAIN=hub.winsvpn.org
HUB_API_BASE=https://sync.winsvpn.org
RUN_YABS=0
APT_ALLOW_REMOVALS=0
ALLOW_UNSUPPORTED_OS=0
ALLOW_UNSUPPORTED_ARCH=0
ALLOW_INSECURE_HUB_HTTP=0
ALLOW_RAW_HUB_ORIGIN=0
# Swap is zram only on every server (owner ruling 2026-09-25). Disk swap is an
# explicit opt-in for a LUKS root; loop-backed encrypted swap deadlocks.
ENABLE_WINS_SWAPFILE=0
ALLOW_UNENCRYPTED_SWAPFILE=0
WINS_SWAPFILE_SIZE=12G
ENABLE_ZRAM_SWAP=1
ZRAM_SWAP_PERCENT=50
ZRAM_SWAP_MAX_MB=2048

# For unattended fleet deployment, generate ADMIN_TOKEN once outside Git and
# inject the same value through /root/winsvpn-secrets.env on the hub, every data
# plane, and the optional core. Strict mode rejects an empty/short value before
# package changes. A disposable non-strict simulation may still auto-generate.
ADMIN_TOKEN=
STRICT_ONE_TOUCH_SECRETS=1
PREFLIGHT_VERIFY_EXTERNAL_CREDENTIALS=1
REQUIRE_REMOTE_BACKUP=1
RCLONE_REMOTE=GoogleDrive_secured
# Required backup remotes must be rclone crypt remotes with standard filename
# encryption, encrypted directory names, data encryption, and password2 salt.
# Put exactly one of these in /root/winsvpn-secrets.env, not in defaults:
# RCLONE_CONFIG_SOURCE=/run/secrets/rclone.conf
# RCLONE_CONFIG_B64=<base64-of-rclone.conf>

# ---------------------------------------------------------------------------
# Control hub integrations
# ---------------------------------------------------------------------------
DEVICE_LIMIT=3
SMTP_SERVER=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Legacy server-side direct-origin SPA only. These are generated automatically
# and unused while HIDE_CONTROL_ORIGIN=1; they are never embedded in an app.
SPA_KEY=
SPA_HMAC=
EMAIL_SENDER=support@winsvpn.org
SECURITY_ALERT_EMAIL=security@winsvpn.com
HUB_SSH_PASSWORD_AUTH=0
# Optional one-touch fallback when the provider image has no authorized_keys.
# Use one complete single-line OpenSSH public key; never put a private key here.
HUB_SSH_PUBLIC_KEY=
HUB_ALLOW_GLOBAL_SSH=0
REQUIRE_CLOUDFLARE_AUTOMATION=1
# The public Gist is a read-only fallback for the stable Tunnel hostname. Leave
# write automation off unless a dedicated, least-privilege Gist token exists.
REQUIRE_ACTIVE_GATEWAY_AUTOMATION=0
HIDE_CONTROL_ORIGIN=1
# Require a Cloudflare Access Service Auth policy in front of every outbound
# node/Core management hostname. The hub remains the only authorized machine.
REQUIRE_CLOUDFLARE_ACCESS=1
# Recovery-only when a named Tunnel cannot start: keep Nginx direct listeners
# reachable exclusively from Cloudflare's dynamically fetched official IPv4
# origin ranges. Never turn this off for a production-facing hub.
CONTROL_DIRECT_CLOUDFLARE_ONLY=1
# Legacy direct-origin UDP knock is unrelated to AWG 9110 and stays closed.
CONTROL_LEGACY_SPA_UDP=0
CONTROL_TUNNEL_NAME=winsvpn-control-origin
# Control API traffic is short-lived; its reviewed hub-specific ceiling remains
# smaller than the long-lived Xray WebSocket proxy ceilings below.
NGINX_WORKER_CONNECTIONS=8192
NGINX_WORKER_NOFILE_LIMIT=65535
PUBLIC_CANARY_ATTEMPTS=6
PUBLIC_CANARY_INTERVAL_SECONDS=10
ACTIVE_GATEWAY_BASE=https://sync.winsvpn.org
ACTIVE_GATEWAY_GIST_ID=325d9caf5c3cda5d6f933e0ac5ba8a02
ACTIVE_GATEWAY_GIST_FILENAME=active-gateway.txt
ACTIVE_GATEWAY_RAW_URL=https://raw.githubusercontent.com/winsvpn/winsvpn-downloads/main/active-gateway.txt
# Optional public map-provider contract returned by the geo endpoint. Set all
# three together to switch Android/Windows/Linux without rebuilding clients.
# Prefer a Win's VPN caching endpoint backed by a provider with an SLA; never
# put a secret provider credential in a URL returned to applications.
MAP_TILE_URL_TEMPLATE=
MAP_TILE_UPSTREAM_URL_TEMPLATE=
MAP_ATTRIBUTION_TEXT=
MAP_ATTRIBUTION_URL=
# Optional: put a fine-grained token with only user Gists: write permission in
# /root/winsvpn-secrets.env only when write automation is explicitly enabled.
GITHUB_GIST_TOKEN=
INSTALL_CONTROL_IDS_IPS=1
INSTALL_DATA_IDS_IPS=1
SURICATA_MIN_VERSION=8.0.7
SURICATA_NFQUEUE_FAIL_OPEN=0
# Classifies every stored Suricata/host event without changing IPS enforcement.
# Only root-confirmed `wins-threat-triage feedback` labels influence later scores.
SECURITY_TRIAGE_ENABLED=1
SECURITY_TRIAGE_ABSENT_PRODUCTS="coldfusion,geoserver,apache solr,tomcat manager,spring actuator,hnap,dvr,camera web interface"
SECURITY_TRIAGE_PRESENT_PRODUCTS=nginx,fastapi,cowrie,openssh,suricata
# Set the trusted source CIDRs that may reach hub SSH. The installer defaults
# should be reviewed before every fresh deployment.
HUB_ADMIN_SSH_CIDRS=
# Example: HUB_ADMIN_SSH_CIDRS=203.0.113.10/32

PAYPAL_MODE=live
PAYPAL_PUBLIC_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_AUTO_ENSURE=1
PAYPAL_WEBHOOK_URL=https://sync.winsvpn.org/webhook/paypal
PUBLIC_PAYMENT_BASE=https://sync.winsvpn.org
PAYPAL_PLAN_1M=
PAYPAL_PLAN_1Y=
PAYPAL_PLAN_PERSONAL=
PAYPAL_LIFETIME_SUPPORT_URL=
PAYPAL_LIFETIME_NO_SUPPORT_URL=
PAYPAL_LIFETIME_SUPPORT_AMOUNT=
PAYPAL_LIFETIME_NO_SUPPORT_AMOUNT=
PAYPAL_LIFETIME_CURRENCY=
PAYPAL_DONATION_URL=
# Commerce secrets (PAYPAL_CLIENT_SECRET, BTCPAY_API_KEY, BTCPAY_WEBHOOK_SECRET)
# belong in /root/winsvpn-secrets.env, never this defaults file. To populate
# an already-deployed hub without a full --deploy, run
# --apply-commerce-secrets after delivering the secrets file. Workstation
# analogue (never in git, never in a handoff): ~/.winsvpn/hub-commerce.env
# modelled on ~/.winsvpn/wfa-release.env. Names-only template:
# server/hub-commerce.env.example

# Cloudflare values are mandatory while REQUIRE_CLOUDFLARE_AUTOMATION=1.
# The app-cloud token needs Zone DNS Edit plus Zone SSL and Certificates Edit:
# data planes use both permissions for DNS + Origin CA, and the secure preseed
# copies that narrowly scoped credential plus its zone ID to the physical core
# for one derived record and Origin certificate. Rotate any token previously
# committed or otherwise exposed before the fresh deployment.
CLOUDFLARE_APPCLOUD_ACCOUNT_ID=
CLOUDFLARE_APPCLOUD_API_TOKEN=
CLOUDFLARE_APPCLOUD_ZONE_ID=
CLOUDFLARE_WINS_ACCOUNT_ID=
CLOUDFLARE_WINS_API_TOKEN=
CLOUDFLARE_WINSVPN_ORG_ZONE_ID=
CLOUDFLARE_WINSVPN_COM_ZONE_ID=
# Tunnel token needs Cloudflare Tunnel Edit; the account ID/token may reuse the
# Wins values only when that token has both the narrow tunnel and DNS scopes.
CLOUDFLARE_TUNNEL_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_API_TOKEN=
# Optional app-zone tunnel connector (wins-appcloud-tunnel) for the compiled
# app fronts: the locally managed tunnel's UUID, its credentials JSON
# (AccountTag, TunnelID, TunnelSecret) and the front host names. Set all three
# or none; none skips the connector. Hub secrets file only; never commit values.
APPCLOUD_TUNNEL_ID=
APPCLOUD_TUNNEL_CREDENTIALS=
APPCLOUD_TUNNEL_HOSTS=
# Dedicated account token with only Access Apps Write, Access Policies Write,
# and Access Service Tokens Write. The installer creates one hub service token
# and persists its generated client credentials in the root-only runtime env.
CLOUDFLARE_ACCESS_API_TOKEN=
CLOUDFLARE_ACCESS_SERVICE_TOKEN_NAME=winsvpn-management-hub
CLOUDFLARE_ACCESS_SERVICE_TOKEN_DURATION=8760h
# Optional recovery inputs. Leave blank on a fresh install; never commit values.
CLOUDFLARE_ACCESS_SERVICE_TOKEN_UUID=
TUNNEL_SERVICE_TOKEN_ID=
TUNNEL_SERVICE_TOKEN_SECRET=
NODE_MANAGEMENT_TUNNEL_ZONE_ID=
NODE_MANAGEMENT_TUNNEL_ZONE_NAME=winsvpn.com
CLOUDFLARE_ORIGIN_CA_VALIDITY_DAYS=730
# Optional renewal notices for the publicly trusted DNS-01 fallback certificate.
ACME_CONTACT_EMAIL=

# Free/premium node access is database-managed after deployment. These are
# optional first-deploy seeds only; no node identity belongs in an app build.
FREE_ACCESS_NODE_SLUGS=
FREE_ACCESS_NODE_MATCHES=
NODE_REGISTER_BLOCKED_HOSTS=
# Compatibility ceiling used only for an older node that does not advertise
# its own NODE_MAX_PEERS. New data planes calculate and register their limit.
DEFAULT_NODE_MAX_PEERS=4096
NODE_RUNTIME_PEER_RESERVE=16
DOUBLE_VPN_ENABLED=1
DOUBLE_VPN_FREE_ACCESS_ENABLED=1

# ---------------------------------------------------------------------------
# Data plane identity and transport overrides
# ---------------------------------------------------------------------------
# NODE_SLUG=
# NODE_NAME=
# NODE_FLAG=
# NODE_HOST=
# STEALTH_HOST=
# REGIONAL_GATEWAY_ALIASES=
NODE_MANAGEMENT_TUNNEL_ENABLED=1
HUB_MANAGEMENT_TUNNEL_BOOTSTRAP_URL=https://sync.winsvpn.org/admin/nodes/bootstrap-management-tunnel
# Leave IONOS_HUB_IP and WINS_HUB_IP unset on every data plane.
# Auto derives a safe per-node customer ceiling from RAM and CPU. Set an
# integer from 1 to 60000 only after load testing that VPS size.
NODE_MAX_PEERS=auto
# Each proxied Xray session consumes a client and upstream socket.  Data role
# values take precedence over the generic control-hub values above, reserve 20%
# descriptor headroom, and clamp auto peer admission to the effective ceiling.
DATA_NGINX_WORKER_CONNECTIONS=32768
DATA_NGINX_WORKER_NOFILE_LIMIT=65535
DATA_NGINX_PROXY_HEADROOM_PERCENT=20
WG_PORT_DEFAULT=9110
STEALTH_ORIGIN_PORT_DEFAULT=80
STEALTH_PUBLIC_PORT_DEFAULT=80
XRAY_INBOUND_PORT_DEFAULT=10085
XRAY_PATH_DEFAULT=/wins-stealth-tunnel
XRAY_SECURITY_DEFAULT=none
# Ordered, node-advertised censorship routes. The first entry is tried first.
STEALTH_TRANSPORTS=80:none,443:tls
XRAY_VERSION=26.9.30
XRAY_LINUX_64_SHA256=f851110beaff16e78d643f0ccfd9524b4a44dfd59bae3e34bb52bba378f7690e
AWG_DOCKER_IMAGES=amneziavpn/amneziawg-go@sha256:acef5ae84808a9568448e9d8c7a96f640a5ccc590b0f8dfbc2df9f9dc0e848c9
# Keep DNS off the public WAN listener; this must match the AWG gateway address.
ADGUARD_DNS_BIND=10.8.1.1
# Deterministic DNS security chain: local official AdGuard filtering, Quad9
# primary resolution, then Cisco OpenDNS only when Quad9 is unavailable.
ADGUARD_PRIMARY_DOH=https://dns.quad9.net/dns-query
ADGUARD_OPENDNS_FALLBACK_DOH=https://dns.opendns.com/dns-query
ADGUARD_HOME_VERSION=0.107.79
ADGUARD_HOME_LINUX_AMD64_SHA256=c48f4a43000665484c5ec28177de11a004759b620dae8f77b2aabefc9ef3687f
# Optional. Inject only the commercial/provider DoH URL issued by
# Whalebone/DNS4EU. The public joindns4.eu endpoints prohibit commercial use.
DNS4EU_COMMERCIAL_DOH_URL=
AWG_MTU=1280
AWG_JC=2
AWG_JMIN=10
AWG_JMAX=30
AWG_S1=16
AWG_S2=80
AWG_S3=16
AWG_S4=0
AWG_H1=11
AWG_H2=22
AWG_H3=33
AWG_H4=44

# Data-plane and Core stealth DNS, Origin CA, ACME and redirect automation is
# brokered by the hub, the only holder of CLOUDFLARE_APPCLOUD_API_TOKEN. Data
# planes and Cores hold no Cloudflare credential and refuse to run with one.
CLOUDFLARE_STEALTH_ZONE=app-cloud-sync.net
# Optional registration/renewal contact for the DNS-01 public-certificate
# fallback used when Cloudflare denies Origin CA issuance to the hub broker.
ACME_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Physical Double VPN core hop
# ---------------------------------------------------------------------------
CORE_ID=north-america-core
CORE_NAME="North America Physical Core"
CORE_REGION="North America"
# Required in production: a per-Core, outbound-only Cloudflare SSH connector.
# It is verified by the hub before and after local firewall/sshd hardening and
# on every Core assignment-sync cycle. Leave the hidden hub IP unset.
CORE_MANAGEMENT_TUNNEL_ENABLED=1
CORE_MANAGEMENT_TUNNEL_BOOTSTRAP_URL=https://sync.winsvpn.org/admin/core/bootstrap-management-tunnel
CORE_MANAGEMENT_VERIFY_URL=https://sync.winsvpn.org/admin/core/verify-management
# Allow up to two minutes for first-run DNS/tunnel propagation. Verification
# still fails closed before firewall or sshd hardening if the callback never works.
CORE_MANAGEMENT_VERIFY_ATTEMPTS=120
CORE_MANAGEMENT_VERIFY_INTERVAL_SECONDS=5
CORE_MANAGEMENT_REUSE_PROBE_ATTEMPTS=12
CORE_SSH_ADMIN_USER=ubuntu
# Optional additional administrator key. The hub's current key is fetched over
# the authenticated API and merged into authorized_keys automatically.
# CORE_SSH_PUBLIC_KEY=
CORE_INGRESS_PORT=9210
CORE_STEALTH_ORIGIN_PORT=80
CORE_STEALTH_TRANSPORTS=80:none,443:tls
# When empty, the one-touch script derives `<CORE_ID>.CORE_STEALTH_ZONE`, creates
# or updates that one proxied A record, obtains a verified Cloudflare Origin CA
# certificate, and never falls back to a self-signed strict-TLS origin.
CORE_STEALTH_HOST=
CORE_STEALTH_ZONE=app-cloud-sync.net
CORE_REQUIRE_CLOUDFLARE_AUTOMATION=1
CORE_XRAY_INBOUND_PORT=10110
CORE_XRAY_PATH=/wins-core-tunnel
CORE_XRAY_SECURITY=none
# Core role values likewise isolate long-lived relay WebSockets from the lower
# control-hub default. "auto" resolves to the two-socket, headroom-safe limit.
CORE_NGINX_WORKER_CONNECTIONS=32768
CORE_NGINX_WORKER_NOFILE_LIMIT=65535
CORE_NGINX_PROXY_HEADROOM_PERCENT=20
CORE_MAX_XRAY_CONNECTIONS=auto
CORE_OPEN_PUBLIC_INGRESS=1
CORE_ENABLE_EXIT=0
CORE_AI_ENABLED=0

# Set these only when explicitly configuring one fixed core exit. Normal
# dynamic core-to-data-plane assignments are synchronized by the hub agent.
# CORE_EXIT_PEER_PUBLIC_KEY=
# CORE_EXIT_ENDPOINT=
# CORE_EXIT_PRESHARED_KEY=

# ---------------------------------------------------------------------------
# App build-time public bootstrap values (never ADMIN_TOKEN)
# ---------------------------------------------------------------------------
WINS_GATEWAY_BASE=https://sync.winsvpn.org
WINS_GATEWAY_BASES="https://sync.winsvpn.com,https://hub.winsvpn.org"
WINS_HUB_HOST=hub.winsvpn.org
WINS_PUBLIC_WEBSITE_URL=https://winsvpn.org
WINS_PUBLIC_REFERRAL_BASE=https://winsvpn.org/referral
WINS_PUBLIC_REFERRAL_BACKUP_BASE=https://winsvpn.com/referral

# ---------------------------------------------------------------------------
# Microsoft Store MSIX identity (not secret; copy exactly from Partner Center)
# ---------------------------------------------------------------------------
# These are deliberately unset until the Win's VPN product name is reserved.
# The Store MSIX builder refuses to guess them. They are unrelated to Azure
# Artifact Signing, which remains necessary only for website-hosted EXE/MSIX.
WINS_MSIX_IDENTITY_NAME=
WINS_MSIX_PUBLISHER=
WINS_MSIX_PUBLISHER_DISPLAY_NAME=
