[Unit]
Description=Win's VPN Control Hub Daily Automated Backup
After=network.target postgresql.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/wins_hub_daily_backup.sh
StandardOutput=journal
StandardError=journal
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/winsvpn /var/log

[Install]
WantedBy=multi-user.target
