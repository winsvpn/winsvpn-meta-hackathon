# Names-only template for hub commerce secrets (PayPal + optional BTCPay).
#
# THIS FILE MUST NEVER CONTAIN LIVE VALUES. Copy it outside git:
#   workstation:  ~/.winsvpn/hub-commerce.env   (mode 600, like wfa-release.env)
#   hub:          /root/winsvpn-secrets.env     (root:root, mode 600)
# Deliver the hub copy with an ssh heredoc, never scp.
# Apply on an already-deployed hub:
#   sudo bash wins_control_plane_setup_ONETOUCH.sh --apply-commerce-secrets
# That path sources this file AFTER /root/vpn_auth.env so filled values win
# over KEY='' placeholders, rewrites only commerce keys, and restarts wins-hub.
# It does not re-provision apt, main.py, REDEMPTION_KEYS, or ADMIN_TOKEN.
#
# Never commit the filled copy. Never paste values into docs/handoff.
# Partial files fail closed and leave vpn_auth.env untouched.

PAYPAL_MODE=live
PAYPAL_PUBLIC_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_AUTO_ENSURE=1
PAYPAL_WEBHOOK_URL=https://sync.winsvpn.org/webhook/paypal
PAYPAL_PLAN_1M=
PAYPAL_PLAN_1Y=
PAYPAL_PLAN_PERSONAL=
PAYPAL_LIFETIME_SUPPORT_URL=
PAYPAL_LIFETIME_NO_SUPPORT_URL=
PAYPAL_LIFETIME_SUPPORT_AMOUNT=
PAYPAL_LIFETIME_NO_SUPPORT_AMOUNT=
PAYPAL_LIFETIME_CURRENCY=
PAYPAL_DONATION_URL=

# Optional. If ANY of the four is set, all four must be set, and BTCPAY_URL
# must be https://. Leave all empty to leave runtime BTCPay unchanged.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Optional Monero wallet RPC (OI-49, Round 36 treaty). The hub treats
# MONERO_WALLET_RPC_USER/PASS as MANDATORY whenever MONERO_WALLET_RPC_URL is
# set, so this triple is all-or-none: fill all three or none. The hub
# (main.py validate_monero_rpc_configuration) refuses plaintext http on any
# non-loopback host and https on any port but 443, and the installer's
# preflight now refuses the same forms. The production value is
# https://monero-rpc.winsvpn.org (Spain's commerce tunnel to nginx
# 127.0.0.1:23001, location /json_rpc), behind a Cloudflare Access
# service-token policy; set MONERO_WALLET_RPC_CF_ACCESS=1 in
# /root/winsvpn-defaults.env (not a secret) so the hub presents the wallet
# hostname's own Access service token (the two keys below). A bare
# http://<WireGuard address>:18083 is refused (no such management path
# exists). --apply-commerce-secrets does NOT apply these three
# keys or the two Access keys below; they reach the hub on the next --deploy.
MONERO_WALLET_RPC_URL=
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASS=
# D7: the monero-rpc Access application's OWN service token (never the
# management token). Required when MONERO_WALLET_RPC_CF_ACCESS=1.
MONERO_WALLET_RPC_CF_ACCESS_CLIENT_ID=
MONERO_WALLET_RPC_CF_ACCESS_CLIENT_SECRET=

# Do not set PAYPAL_ALLOW_UNVERIFIED_WEBHOOKS. The apply path refuses it.
