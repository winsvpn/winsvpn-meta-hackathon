# Server-only settings. Do not copy this file into any client application.
SMART_ROUTER_HMAC_SECRET=
# Live-compatible alias if the canonical secret name is not used:
# EDGE_ROUTER_SECRET=
SMART_ROUTER_GEMMA_MODEL=
# Owner-reviewed immutable Gemma identity. Keep empty until supplied with the
# exact revision, artifact root, and inventory SHA-256.
SMART_ROUTER_GEMMA_MODEL_REVISION=
SMART_ROUTER_GEMMA_ARTIFACT_ROOT=
SMART_ROUTER_GEMMA_ARTIFACT_INVENTORY_SHA256=
SMART_ROUTER_GEMMA_URL=http://127.0.0.1:8002
# Live-compatible model and URL aliases:
# LOCAL_MODEL=
# LOCAL_LLM_URL=http://127.0.0.1:8002
# GEMMA_MODEL=
# VLLM_URL=http://127.0.0.1:8002/v1/chat/completions
# Optional loopback vLLM credential:
# VLLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
SMART_ROUTER_TOTAL_BUDGET_MS=2000
SMART_ROUTER_LOCAL_TIMEOUT_MS=900
SMART_ROUTER_GOOGLE_TIMEOUT_MS=900
SMART_ROUTER_QUEUE_TIMEOUT_MS=20
SMART_ROUTER_MAX_CONCURRENT_REQUESTS=8
SMART_ROUTER_MAX_BODY_BYTES=32768
SMART_ROUTER_RATE_LIMIT_REQUESTS=120
SMART_ROUTER_RATE_WINDOW_SECONDS=60
SMART_ROUTER_AUTH_WINDOW_SECONDS=30
# Create this directory as the process user with mode 0700 before a local run:
#   mkdir -m 700 /tmp/winsvpn-router-state
SMART_ROUTER_NONCE_JOURNAL_PATH=/tmp/winsvpn-router-state/replay-nonces.sqlite3
DECISIONS_FILE=/tmp/winsvpn-router-state/router-decisions.jsonl
PORT=8090
