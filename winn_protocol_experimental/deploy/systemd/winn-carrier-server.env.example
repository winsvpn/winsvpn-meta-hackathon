WINN_CARRIER_LISTEN=0.0.0.0:443
# The private ECH-inner SNI that selects the Winn TLS profile is derived from
# the DNS SAN on the server certificate. Override it by adding
# -cover-server-name <name> to the unit only if the certificate carries
# several names. The cover certificate at /etc/winn/credentials/cover.pem
# must be for a DIFFERENT, ordinary name - it is what every prober sees.
WINN_CARRIER_METRICS_LISTEN=127.0.0.1:9092
WINN_CARRIER_PUBLIC_TARGET=winn.invalid:443
WINN_CARRIER_AWG_BACKEND=127.0.0.1:51820
WINN_CARRIER_NODE_ID=carrier-us-east-1
WINN_CARRIER_AUTHORIZATION_MODE=identity
WINN_CARRIER_MAX_DATAGRAM=1350
WINN_CARRIER_REPLAY_LIMIT=100000
WINN_CARRIER_RATE_BURST=10
WINN_CARRIER_RATE_PER_MINUTE=30
WINN_CARRIER_RATE_MAX_KEYS=100000
WINN_CARRIER_MAX_CONCURRENT=1024
