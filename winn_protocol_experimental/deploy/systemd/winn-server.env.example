WINN_LISTEN=0.0.0.0:9443
# The private ECH-inner SNI that selects the Winn TLS profile is derived from
# the DNS SAN on the server certificate. Override it by adding
# -cover-server-name <name> to the unit only if the certificate carries
# several names. The cover certificate at /etc/winn/credentials/cover.pem
# must be for a DIFFERENT, ordinary name - it is what every prober sees.
WINN_ADMIN_LISTEN=127.0.0.1:9095
WINN_SUITE=x25519-mlkem768
WINN_CONTROLLER_ID=winn-controller-1
WINN_KEY_TTL=24h
WINN_AWG_BINARY=/usr/local/sbin/awg
WINN_AWG_INTERFACE=awg0
WINN_RATE_BURST=6
WINN_RATE_PER_MINUTE=12
WINN_RATE_MAX_KEYS=100000
WINN_MAX_CONCURRENT=128
WINN_POSTGRES_MAX_CONNECTIONS=16
