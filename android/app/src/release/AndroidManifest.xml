<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Release touch filtering is installed on MainActivity's decor View. -->

    <!-- Release builds declare themselves non-debuggable; the release signer gate
         requires the explicit attribute (tools/verify_android_aab_signers.py). -->
    <application
        android:debuggable="false"
        tools:ignore="HardcodedDebugMode">
        <activity android:name=".MainActivity" />
    </application>
</manifest>
