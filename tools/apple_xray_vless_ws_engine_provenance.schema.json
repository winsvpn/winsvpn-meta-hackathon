{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winsvpn.local/schemas/apple_xray_vless_ws_engine_provenance.json",
  "title": "Apple Xray VLESS-WS delivered-artifact provenance",
  "description": "Fail-closed binding for delivered iOS, macOS, and simulator libWinsXrayVlessWsTransport.dylib files. Distinct from apple_awg_31_engine_provenance.json and apple_winn_v3_engine_provenance.json. Compiling WinsXrayVlessWsTransport.m in a test harness is not evidence that a provenance-bound or embedded dylib was built from that source. A matching document is produced only by a verified wrapper rebuild; absence, a symlink, a source-hash mismatch, or missing production imports is owner-blocked / rebuild-required. Mutating the wrapper source after artifact creation must fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "builders",
    "component",
    "generation",
    "required_exported_symbols",
    "required_undefined_symbols",
    "schema_version",
    "source",
    "wrappers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "component": {
      "type": "string",
      "const": "xray-apple-vless-ws-engine-wrappers"
    },
    "generation": {
      "type": "string",
      "const": "vless-ws"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "apple/EngineWrappers/WinsXrayVlessWsTransport.m"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "builders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrapper_builder"
      ],
      "properties": {
        "wrapper_builder": {
          "$ref": "#/$defs/path_digest"
        }
      }
    },
    "required_exported_symbols": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "wins_xray_vless_ws_transport_configure",
          "wins_xray_vless_ws_transport_contract_version",
          "wins_xray_vless_ws_transport_start",
          "wins_xray_vless_ws_transport_stop"
        ]
      }
    },
    "required_undefined_symbols": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "LibXraySetSockCallback",
          "dup2",
          "getifaddrs",
          "setsockopt"
        ]
      }
    },
    "wrappers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iphoneos",
        "iphonesimulator",
        "macosx"
      ],
      "properties": {
        "iphoneos": {
          "$ref": "#/$defs/wrapper_record"
        },
        "iphonesimulator": {
          "$ref": "#/$defs/wrapper_record"
        },
        "macosx": {
          "$ref": "#/$defs/wrapper_record"
        }
      }
    }
  },
  "$defs": {
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "wrapper_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectures",
        "exported_symbols",
        "filetype",
        "path",
        "platform",
        "sha256",
        "undefined_symbols"
      ],
      "properties": {
        "architectures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exported_symbols": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "undefined_symbols": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filetype": {
          "type": "string",
          "const": "mach-o-dylib"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": [
            "IOS",
            "IOSSIMULATOR",
            "MACOS"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_normalized_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
