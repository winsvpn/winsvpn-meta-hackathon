#!/bin/bash
# Generated by wins_data_plane_setup_ONETOUCH.sh -- do not edit by hand.
# Rebuild it by re-running write_runtime_vpn_firewall_unit from that installer.
#
# Re-applies the two firewall subsets that make this node a working VPN.
#
# WHY THIS EXISTS: iptables rules here are runtime-only, and the mechanism that
# would normally restore them -- wins-edge-hardening.timer -- is DELIBERATELY
# DISABLED because the full artifact closes tcp/80 and tcp/22 (no admission
# file, Suricata absent). Without this unit a reboot silently drops client
# egress and the Cloudflare-only stealth restriction, and the node looks healthy
# while carrying nobody.
#
# Both halves are idempotent, including every base-chain jump. Runs after docker
# so --noflush cannot race Docker's own chain creation.
#
# THE STEALTH HALF FAILS CLOSED (changed 2026-08-06). It never leaves tcp/80 and
# tcp/443 open because a fetch failed, and it exits non-zero whenever it could
# not refresh its own allowlist, so a degraded node shows up in
# `systemctl --failed` instead of looking healthy while publishing its origin.
# See the ladder in section 4.
set -u

# The three @...@ defaults are substituted with this node's real values by the
# installer. They stay inside ${VAR:-...} so the pre-substitution body is still
# valid shell and lints clean, and so the values remain overridable for testing.
WINVPN_FW_IFACES="${WINVPN_FW_IFACES:-awg0 amn0}"
WINVPN_FW_WAN_IF="${WINVPN_FW_WAN_IF:-ens3}"
WINVPN_FW_VPN_CIDR="${WINVPN_FW_VPN_CIDR:-10.8.0.0/16}"
WINVPN_FW_TRANSACTION="${WINVPN_FW_TRANSACTION:-/root/wins-forward-nat.transaction}"
WINVPN_FW_CF_URL="${WINVPN_FW_CF_URL:-https://www.cloudflare.com/ips-v4}"
# Last known-good Cloudflare list. Written only after a fetched list passes
# every validation below, so a truncated or corrupted response can never become
# the cache it is later trusted as.
WINVPN_FW_CF_CACHE="${WINVPN_FW_CF_CACHE:-/var/lib/winsvpn/cloudflare-ips-v4.cache}"
# Plausibility bounds. Cloudflare has published 14-17 IPv4 ranges for years; the
# window is deliberately wide enough to absorb ordinary churn and narrow enough
# that a truncated body or an error page cannot pass as a range list.
WINVPN_FW_CF_MIN_RANGES="${WINVPN_FW_CF_MIN_RANGES:-10}"
WINVPN_FW_CF_MAX_RANGES="${WINVPN_FW_CF_MAX_RANGES:-64}"
# A cache this old means the fetch has been failing for a month, not for a
# moment. At that point the node keeps its protection but stops being quiet
# about it: the unit exits non-zero and shows up in `systemctl --failed`.
WINVPN_FW_CF_CACHE_MAX_AGE_DAYS="${WINVPN_FW_CF_CACHE_MAX_AGE_DAYS:-30}"
# Same off-box test hooks as wins-edge-hardening (IPTABLES_BIN et al), so the
# idempotency of this script -- and every branch of its fail-closed ladder --
# can be proven by execution without a real node.
IPT_BIN="${IPTABLES_BIN:-iptables}"
IPT_RESTORE_BIN="${IPTABLES_RESTORE_BIN:-iptables-restore}"
CURL_BIN="${CURL_BIN:-curl}"

winvpn_fw_rc=0
log() { logger -t wins-vpn-firewall "$*" 2>/dev/null || true; echo "wins-vpn-firewall: $*"; }
warn() { logger -p daemon.warning -t wins-vpn-firewall "WARN: $*" 2>/dev/null || true; echo "wins-vpn-firewall: WARN: $*"; }
fail() {
  logger -p daemon.err -t wins-vpn-firewall "ERROR: $*" 2>/dev/null || true
  echo "wins-vpn-firewall: ERROR: $*" >&2
  winvpn_fw_rc=1
}
ipt() { "${IPT_BIN}" -w 10 "$@"; }

# The one correct way to add a base-chain jump. A bare -I duplicates on rerun.
ensure_jump() {
  local table="$1" base="$2" target="$3"
  shift 3
  if ipt -t "${table}" -C "${base}" "$@" -j "${target}" 2>/dev/null; then
    return 0
  fi
  ipt -t "${table}" -I "${base}" 1 "$@" -j "${target}"
}

jump_count() {
  local table="$1" base="$2" target="$3"
  ipt -t "${table}" -S "${base}" 2>/dev/null | grep -c -- "-j ${target}\$"
}

assert_jump_count() {
  local table="$1" base="$2" target="$3" want="$4" have
  have="$(jump_count "${table}" "${base}" "${target}")"
  [[ "${have}" == "${want}" ]] && return 0
  fail "${table}/${base} carries ${have} jump(s) to ${target}, expected ${want}"
}

winvpn_fw_ifaces=()
read -r -a winvpn_fw_ifaces <<< "${WINVPN_FW_IFACES}"
[[ ${#winvpn_fw_ifaces[@]} -gt 0 ]] || winvpn_fw_ifaces=(awg0 amn0)

# 1. Client egress: FORWARD accept + MASQUERADE for the VPN subnet.
if [[ -f "${WINVPN_FW_TRANSACTION}" ]]; then
  if "${IPT_RESTORE_BIN}" --wait 10 --noflush < "${WINVPN_FW_TRANSACTION}"; then
    log "egress subset applied"
  else
    fail "egress subset FAILED to apply"
  fi
else
  fail "${WINVPN_FW_TRANSACTION} missing; client egress NOT restored"
fi

# 2. Base-chain jumps, conditionally. Never a bare -I: see the installer header.
if (( winvpn_fw_rc == 0 )); then
  ipt -N DOCKER-USER 2>/dev/null || true
  for winvpn_fw_iface in "${winvpn_fw_ifaces[@]}"; do
    ensure_jump filter FORWARD WINVPN-FORWARD -i "${winvpn_fw_iface}" \
      || fail "filter FORWARD -i ${winvpn_fw_iface} jump failed"
    ensure_jump filter FORWARD WINVPN-FORWARD -o "${winvpn_fw_iface}" \
      || fail "filter FORWARD -o ${winvpn_fw_iface} jump failed"
    ensure_jump mangle FORWARD WINVPN-MANGLE-FORWARD -i "${winvpn_fw_iface}" \
      || fail "mangle FORWARD -i ${winvpn_fw_iface} jump failed"
    ensure_jump mangle FORWARD WINVPN-MANGLE-FORWARD -o "${winvpn_fw_iface}" \
      || fail "mangle FORWARD -o ${winvpn_fw_iface} jump failed"
  done
  ensure_jump nat POSTROUTING WINVPN-NAT-POSTROUTING || fail "nat POSTROUTING jump failed"
  ensure_jump filter DOCKER-USER WINVPN-DOCKER || fail "DOCKER-USER jump failed"
fi

# 3. Prove what the old transaction could not. Without these assertions this
#    unit can exit 0 having restored nothing, which is the difference between a
#    working node and one that answers but carries nobody.
if (( winvpn_fw_rc == 0 )); then
  assert_jump_count filter FORWARD WINVPN-FORWARD "$(( ${#winvpn_fw_ifaces[@]} * 2 ))"
  assert_jump_count mangle FORWARD WINVPN-MANGLE-FORWARD "$(( ${#winvpn_fw_ifaces[@]} * 2 ))"
  assert_jump_count nat POSTROUTING WINVPN-NAT-POSTROUTING 1
  assert_jump_count filter DOCKER-USER WINVPN-DOCKER 1

  winvpn_fw_current_wan="$(ip -o route show default 2>/dev/null | awk '{print $5; exit}')"
  if [[ -n "${WINVPN_FW_WAN_IF}" && -n "${winvpn_fw_current_wan}" \
        && "${winvpn_fw_current_wan}" != "${WINVPN_FW_WAN_IF}" ]]; then
    fail "WAN is now ${winvpn_fw_current_wan} but the transaction masquerades out ${WINVPN_FW_WAN_IF}; re-run the data-plane installer"
  fi
  if [[ -n "${WINVPN_FW_WAN_IF}" ]] && ! ipt -t nat -C WINVPN-NAT-POSTROUTING \
      -s "${WINVPN_FW_VPN_CIDR}" -o "${WINVPN_FW_WAN_IF}" -j MASQUERADE 2>/dev/null; then
    fail "MASQUERADE ${WINVPN_FW_VPN_CIDR} out ${WINVPN_FW_WAN_IF} is absent; this node would answer but carry nobody"
  fi
fi

# 4. Stealth ports reachable only via Cloudflare (hides the origin from raw-IP
#    probes).
#
#    THIS HALF USED TO FAIL OPEN. If the range fetch failed it logged a warning,
#    exited 0, and left tcp/80 and tcp/443 answering the whole Internet. That
#    turned a transient DNS blip -- or any change at Cloudflare -- into the
#    silent loss of the single strongest property in this posture, and the
#    failure was invisible precisely because everything else kept working. On a
#    node whose iptables rules are runtime-only, a reboot plus one failed fetch
#    was enough to publish the origin.
#
#    It now fails CLOSED, down a ladder that never installs an empty or
#    permissive chain:
#
#      1. a freshly fetched list that VALIDATES  -> apply it, refresh the cache
#      2. else the on-disk last known-good cache -> apply it, warn (or fail
#                                                   loudly once it is stale)
#      3. else the ruleset already in the kernel -> keep it untouched, fail
#      4. else                                   -> lock 80/443 down, fail
#
#    Step 4 costs the TCP fallback until the 30-minute reapply timer recovers
#    it. That is the correct trade: UDP/9110 keeps carrying traffic meanwhile,
#    and in this threat model an origin that has been confirmed once is burned
#    permanently, while a fallback that is down for half an hour is not.

# A well-formed IPv4 CIDR, and specifically NOT a permissive one: anything
# shorter than /8 (0.0.0.0/0 above all) is refused outright, because the whole
# purpose of this chain is that it does not contain a rule that matches
# everybody.
winvpn_fw_valid_cidr() {
  local cidr="${1-}" addr prefix octet
  [[ "${cidr}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] || return 1
  addr="${cidr%/*}"
  prefix="${cidr#*/}"
  prefix="$((10#${prefix}))"
  ((prefix >= 8 && prefix <= 32)) || return 1
  local IFS=.
  # shellcheck disable=SC2206
  local octets=(${addr})
  for octet in "${octets[@]}"; do
    [[ "${octet}" =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#${octet} <= 255)) || return 1
  done
  return 0
}

# Whole-list validation. Every check here exists because of a specific way the
# fetch can lie: an error page or a truncated body (count too low), a mirror
# that pads or an HTML dump (count too high, malformed entries), a duplicated
# stream (duplicates), and an allow-everything entry (prefix < /8).
winvpn_fw_valid_cf_list() {
  local label="${1-}"
  shift
  local count=$# entry seen=""
  if ((count < WINVPN_FW_CF_MIN_RANGES)); then
    warn "${label}: ${count} range(s) is below the plausible minimum ${WINVPN_FW_CF_MIN_RANGES}"
    return 1
  fi
  if ((count > WINVPN_FW_CF_MAX_RANGES)); then
    warn "${label}: ${count} range(s) is above the plausible maximum ${WINVPN_FW_CF_MAX_RANGES}"
    return 1
  fi
  for entry in "$@"; do
    if ! winvpn_fw_valid_cidr "${entry}"; then
      warn "${label}: refusing malformed or over-broad entry"
      return 1
    fi
    case " ${seen} " in
      *" ${entry} "*)
        warn "${label}: refusing duplicated entry"
        return 1
        ;;
    esac
    seen="${seen} ${entry}"
  done
  return 0
}

# Rebuild the chain so that it is never LESS closed than its final state, not
# even for the microseconds of the rebuild. DROP goes in first, every RETURN is
# inserted above it afterwards. The obvious ordering -- flush, add RETURNs, add
# DROP -- leaves a window in which the chain is empty, and an empty chain means
# every packet falls back through INPUT to ACCEPT. That window is exactly the
# fail-open this function exists to remove.
winvpn_fw_build_stealth_chain() {
  local entry
  if ! ipt -N WINVPN-STEALTH-CF 2>/dev/null; then
    ipt -F WINVPN-STEALTH-CF || {
      fail "could not flush WINVPN-STEALTH-CF; leaving the existing ruleset in place"
      return 1
    }
  fi
  ipt -A WINVPN-STEALTH-CF -j DROP || {
    fail "could not seed the stealth DROP rule; leaving the existing ruleset in place"
    return 1
  }
  for entry in "$@"; do
    ipt -I WINVPN-STEALTH-CF 1 -s "${entry}" -j RETURN \
      || fail "could not admit Cloudflare range into the stealth chain"
  done
  ipt -I WINVPN-STEALTH-CF 1 -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN \
    || fail "could not admit established flows into the stealth chain"
  ipt -I WINVPN-STEALTH-CF 1 -i lo -j RETURN \
    || fail "could not admit loopback into the stealth chain"
  # Prove the chain actually ends in DROP before anything is routed into it. A
  # chain that does not is a chain that returns, i.e. an open port.
  ipt -C WINVPN-STEALTH-CF -j DROP 2>/dev/null || {
    fail "WINVPN-STEALTH-CF does not end in DROP after rebuild"
    return 1
  }
  ensure_jump filter INPUT WINVPN-STEALTH-CF -p tcp -m multiport --dports 80,443 \
    || { fail "stealth INPUT jump failed"; return 1; }
  return 0
}

# How many Cloudflare-shaped RETURN rules the live chain already carries. This
# is what makes "keep the previously-applied ruleset" a real option instead of
# a hope: the kernel is itself a last known-good store.
winvpn_fw_live_range_count() {
  ipt -S WINVPN-STEALTH-CF 2>/dev/null \
    | grep -c -E '^-A WINVPN-STEALTH-CF -s [0-9.]+/[0-9]+ -j RETURN$' \
    || true
}

# `read -r -a` leaves the array UNSET when the input is empty, and under `set -u`
# an unset array expansion aborts the shell on bash < 4.4 -- i.e. on precisely
# the empty-response path this ladder exists to survive. Word-split assignment
# always declares the array. Globbing is disabled around it so a garbage
# response carrying a shell wildcard cannot expand against the filesystem, and
# every later expansion uses the ${x[@]+"${x[@]}"} guard for the same reason.
winvpn_fw_split_ranges() {
  local restore_glob=1
  case "$-" in *f*) restore_glob=0 ;; esac
  set -f
  # shellcheck disable=SC2206
  winvpn_fw_cf_ranges=(${1-})
  ((restore_glob)) && set +f
  return 0
}

winvpn_fw_cf_ranges=()
winvpn_fw_cf_source=""
WINVPN_FW_CF="$("${CURL_BIN}" -fsS --max-time 10 "${WINVPN_FW_CF_URL}" 2>/dev/null | tr '\n' ' ')" || WINVPN_FW_CF=""
winvpn_fw_split_ranges "${WINVPN_FW_CF}"
if winvpn_fw_valid_cf_list "fetched Cloudflare list" ${winvpn_fw_cf_ranges[@]+"${winvpn_fw_cf_ranges[@]}"}; then
  winvpn_fw_cf_source="fetched"
else
  winvpn_fw_cf_ranges=()
  warn "Cloudflare range fetch did not validate; falling back to the last known-good list"
  if [[ -r "${WINVPN_FW_CF_CACHE}" ]]; then
    winvpn_fw_split_ranges "$(tr '\n' ' ' < "${WINVPN_FW_CF_CACHE}")"
    if winvpn_fw_valid_cf_list "cached Cloudflare list" ${winvpn_fw_cf_ranges[@]+"${winvpn_fw_cf_ranges[@]}"}; then
      winvpn_fw_cf_source="cache"
    else
      winvpn_fw_cf_ranges=()
      fail "the cached Cloudflare list is itself invalid: ${WINVPN_FW_CF_CACHE}"
    fi
  fi
fi

if [[ "${winvpn_fw_cf_source}" == "fetched" ]]; then
  # Cache only what has already validated, and replace atomically so a crash
  # mid-write cannot leave a truncated file that the next run would trust.
  if mkdir -p -- "$(dirname -- "${WINVPN_FW_CF_CACHE}")" 2>/dev/null \
      && printf '%s\n' ${winvpn_fw_cf_ranges[@]+"${winvpn_fw_cf_ranges[@]}"} > "${WINVPN_FW_CF_CACHE}.tmp" 2>/dev/null; then
    chmod 600 "${WINVPN_FW_CF_CACHE}.tmp" 2>/dev/null || true
    mv -f -- "${WINVPN_FW_CF_CACHE}.tmp" "${WINVPN_FW_CF_CACHE}" 2>/dev/null \
      || warn "could not refresh ${WINVPN_FW_CF_CACHE}"
  else
    rm -f -- "${WINVPN_FW_CF_CACHE}.tmp" 2>/dev/null || true
    warn "could not write ${WINVPN_FW_CF_CACHE}"
  fi
  winvpn_fw_build_stealth_chain ${winvpn_fw_cf_ranges[@]+"${winvpn_fw_cf_ranges[@]}"} \
    && log "cloudflare-only stealth applied (${#winvpn_fw_cf_ranges[@]} ranges, fetched)"
elif [[ "${winvpn_fw_cf_source}" == "cache" ]]; then
  winvpn_fw_build_stealth_chain ${winvpn_fw_cf_ranges[@]+"${winvpn_fw_cf_ranges[@]}"} \
    && log "cloudflare-only stealth applied (${#winvpn_fw_cf_ranges[@]} ranges, from cache)"
  if [[ -n "$(find "${WINVPN_FW_CF_CACHE}" -mtime "+${WINVPN_FW_CF_CACHE_MAX_AGE_DAYS}" -print -quit 2>/dev/null)" ]]; then
    fail "the Cloudflare range fetch has been failing for over ${WINVPN_FW_CF_CACHE_MAX_AGE_DAYS} days; stealth is running on a stale cached list"
  else
    warn "using the cached Cloudflare list; the fetch from ${WINVPN_FW_CF_CACHE_MAX_AGE_DAYS}-day window is failing"
  fi
elif (( $(winvpn_fw_live_range_count) >= WINVPN_FW_CF_MIN_RANGES )); then
  # Neither a fetch nor a cache, but the kernel still carries a plausible
  # ruleset from an earlier run. Touching it could only make it worse, so the
  # correct action is to leave it exactly as it is -- and to be loud, because
  # this node can no longer refresh its own allowlist.
  fail "no valid Cloudflare list from the network or the cache; KEEPING the previously-applied stealth ruleset ($(winvpn_fw_live_range_count) ranges) untouched"
  ensure_jump filter INPUT WINVPN-STEALTH-CF -p tcp -m multiport --dports 80,443 \
    || fail "stealth INPUT jump failed"
else
  # Nothing anywhere. Closing 80/443 is the only option that does not publish
  # the origin; the reapply timer re-tries every 30 minutes.
  fail "no valid Cloudflare list from the network, the cache, or the live ruleset; LOCKING DOWN tcp/80 and tcp/443 rather than exposing the origin"
  winvpn_fw_build_stealth_chain \
    && log "stealth ports locked down (loopback and established flows only)"
fi
exit "${winvpn_fw_rc}"
