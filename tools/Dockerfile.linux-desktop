# Win's VPN — Linux desktop (GTK) release builder, captured as a recipe.
#
# WHY THIS FILE EXISTS
# --------------------
# Linux arm64 was carried for a long time as a "fragile" cell resting on one
# hand-built artifact and on a note reading "the constraint is real -- no Linux
# arm64 SDK exists". That note was half right, and the half that was wrong is
# what made the cell look fragile:
#
#   * TRUE:  Google publishes no Linux **arm64 SDK tarball**. `releases_linux.json`
#            has no arm64 archive entry, so the SDK cannot be downloaded --
#            it must be `git clone`d at a tag. That is what this file does.
#   * FALSE: "Flutter does not support Linux arm64". Flutter publishes genuine
#            **linux-arm64 engine artifacts**, and `flutter precache --linux` on
#            an aarch64 host fetches them by name:
#                linux-arm64-release/linux-arm64-flutter-gtk
#            The ASSERT-PRECACHE step below fails the image build if that exact
#            artifact name is absent from precache output, so this claim can
#            never quietly decay back into folklore.
#
# The same recipe serves both Linux cells; the architecture is derived from the
# base image rather than passed in, so a `--platform` mistake cannot produce a
# binary labelled as something it is not:
#
#   docker build --platform linux/arm64 ...   -> aarch64 toolchain -> ELF64 AArch64
#   docker build --platform linux/amd64 ...   -> x86_64  toolchain -> ELF64 X86-64
#
# On an all-aarch64 fleet the linux/amd64 invocation runs under qemu-x86_64
# emulation. Emulation does not change emitted machine code -- the compiler is
# an x86_64 compiler targeting x86_64 -- but it is slow, so treat the amd64
# invocation as "repeatable", not "fast".
#
# SELECTING THE ARCHITECTURE, ON A DOCKER WITHOUT BUILDKIT
# --------------------------------------------------------
# `docker build --platform linux/amd64` DOES NOT WORK on the colima docker this
# was developed against: buildx is absent, so the classic builder replays cached
# arm64 layers and then dies at the first new layer with
#     "image ... was found but does not provide the specified platform".
# It fails loudly rather than silently mislabelling, but it does not build.
# The portable alternative, used by tools/build_linux_desktop_container.sh, is
# to pin the BASE IMAGE to a specific platform's manifest digest. `docker run`
# emulation (qemu-x86_64 binfmt) IS registered, so an amd64 base image simply
# runs emulated and every derived layer is genuinely amd64:
#     BASE_IMAGE=ubuntu:24.04@sha256:<the amd64 manifest digest>
# Get the digest with `docker manifest inspect ubuntu:24.04`. Nothing here
# trusts the tag to mean an architecture.
#
# BUILD CONTEXT
# -------------
# This Dockerfile expects a *staged minimal context*, not the repo root: the
# repo carries multi-GB `.artifacts/` and `build/` trees that must not be sent
# to the daemon. `tools/build_linux_desktop_container.sh` stages exactly the
# paths this file COPYs and then invokes `docker build`. Use that script.
#
# `windows/` IS STAGED DELIBERATELY. linux/runner/linux_winn_host.cc does
#     #include "../../windows/runner/winn_frame.h"
# so a missing or partial `windows/` breaks the *Linux* build. This is not
# leftover cruft in the staging list.
#
# WHAT THIS DOES NOT DO
# ---------------------
# It compiles and links. It does not run the app, does not start a VPN session,
# and establishes no runtime guarantee whatsoever. It also is not the signed
# release pipeline (`tools/build_linux_release.sh`) -- it is the reproducible
# capture of the *compile* recipe that pipeline's Linux cells depend on.

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# FLUTTER_REF intentionally has NO default: the only supported build path is
# tools/build_linux_desktop_container.sh, and that script resolves the tag from
# tools/toolchain-pins.json at run time and passes it in. A bare `docker build`
# therefore fails loudly at the clone step instead of silently baking a
# hardcoded tag that the next pin bump would desynchronise.
ARG FLUTTER_REF=
ARG FLUTTER_REPOSITORY=https://github.com/flutter/flutter.git
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---------------------------------------------------------------------------
# 1. Native toolchain. This is the whole provisioning list -- the 2026-08-06
#    build matrix session installed exactly these into a bare ubuntu:24.04
#    aarch64 container and `flutter build linux --release` succeeded in minutes.
#    libglu1-mesa is included because `flutter doctor` probes for it; the build
#    itself does not link against GLU.
# ---------------------------------------------------------------------------
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        clang cmake ninja-build pkg-config \
        libgtk-3-dev libsecret-1-dev libglu1-mesa \
        git curl unzip xz-utils ca-certificates file binutils && \
    rm -rf /var/lib/apt/lists/*

# ASSERT-DEPS: the two pkg-config modules the Linux runner actually links.
# `flutter build linux` fails late and confusingly when either is missing, so
# fail early and legibly instead.
RUN set -eu; \
    for module in gtk+-3.0 libsecret-1; do \
        printf '%-14s ' "$module"; \
        pkg-config --modversion "$module" || { echo "MISSING"; exit 1; }; \
    done

# ---------------------------------------------------------------------------
# 2. Flutter SDK by `git clone` at a tag -- NOT by tarball download.
#    There is no arm64 SDK tarball to download (see header). Cloning is the
#    only route on aarch64, and using it on both arches keeps one recipe.
# ---------------------------------------------------------------------------
RUN git clone --depth 1 -b "${FLUTTER_REF}" "${FLUTTER_REPOSITORY}" /opt/flutter && \
    git config --global --add safe.directory /opt/flutter && \
    flutter config --no-analytics >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 3. Engine artifacts, and the assertion that makes this file infrastructure
#    rather than documentation.
#
#    `flutter precache --linux` names each artifact it fetches. On aarch64 that
#    list contains linux-arm64-release/linux-arm64-flutter-gtk; on x86_64 it
#    contains linux-x64-release/linux-x64-flutter-gtk. We resolve the expected
#    name from dpkg's own view of the machine and then REQUIRE it in the output.
#    If Flutter ever stops publishing the linux-arm64 engine, this image build
#    fails here -- loudly, at provisioning time, on the assertion that the
#    published artifact exists.
# ---------------------------------------------------------------------------
RUN set -eu; \
    debian_arch="$(dpkg --print-architecture)"; \
    case "$debian_arch" in \
        arm64) flutter_arch=linux-arm64 ;; \
        amd64) flutter_arch=linux-x64 ;; \
        *) echo "unsupported build architecture: $debian_arch" >&2; exit 1 ;; \
    esac; \
    echo "$flutter_arch" > /opt/flutter-target-arch; \
    flutter --version; \
    flutter precache --linux 2>&1 | tee /opt/precache.log; \
    expected="${flutter_arch}-release/${flutter_arch}-flutter-gtk"; \
    grep -F -- "$expected" /opt/precache.log >/dev/null || { \
        echo "ASSERT-PRECACHE FAILED: precache did not fetch '$expected'." >&2; \
        echo "Flutter's published engine artifacts for this arch have changed." >&2; \
        exit 1; }; \
    echo "ASSERT-PRECACHE OK: fetched $expected"

# ---------------------------------------------------------------------------
# 4. Source. Staged by tools/build_linux_desktop_container.sh -- see header for
#    why `windows/` is in this list.
# ---------------------------------------------------------------------------
WORKDIR /src
COPY pubspec.yaml pubspec.lock analysis_options.yaml .metadata ./
COPY lib     ./lib
COPY linux   ./linux
COPY windows ./windows
COPY assets  ./assets

# ---------------------------------------------------------------------------
# 5. Build, then verify the artifact's ELF machine type IN THE IMAGE. A build
#    that silently produced the wrong machine type fails here rather than on a
#    user's machine.
# ---------------------------------------------------------------------------
RUN set -eu; \
    flutter config --enable-linux-desktop >/dev/null 2>&1 || true; \
    flutter pub get; \
    flutter build linux --release

RUN set -eu; \
    flutter_arch="$(cat /opt/flutter-target-arch)"; \
    case "$flutter_arch" in \
        linux-arm64) bundle_dir=build/linux/arm64/release/bundle; expected_machine='AArch64' ;; \
        linux-x64)   bundle_dir=build/linux/x64/release/bundle;   expected_machine='Advanced Micro Devices X86-64' ;; \
    esac; \
    binary="$bundle_dir/wins_vpn"; \
    test -f "$binary" || { echo "ASSERT-ARTIFACT FAILED: $binary not produced." >&2; exit 1; }; \
    echo "$bundle_dir" > /opt/bundle-dir; \
    echo "=== file ==="; file "$binary"; \
    echo "=== readelf -h ==="; readelf -h "$binary"; \
    readelf -h "$binary" | grep -q "Class: *ELF64" || { \
        echo "ASSERT-ELF FAILED: $binary is not ELF64." >&2; exit 1; }; \
    readelf -h "$binary" | grep -q "Machine: *$expected_machine" || { \
        echo "ASSERT-ELF FAILED: $binary is not $expected_machine." >&2; exit 1; }; \
    readelf -h "$bundle_dir/lib/libapp.so" | grep -q "Machine: *$expected_machine" || { \
        echo "ASSERT-ELF FAILED: libapp.so is not $expected_machine." >&2; exit 1; }; \
    echo "ASSERT-ELF OK: ELF64 $expected_machine (wins_vpn and lib/libapp.so)"; \
    echo "size_bytes=$(stat -c %s "$binary")"

# The bundle is extracted with `docker cp` by the companion script; there is no
# CMD worth running here. Executing the artifact is explicitly out of scope --
# nothing in this project has established a Linux runtime guarantee.
CMD ["/bin/sh", "-c", "cat /opt/bundle-dir"]
