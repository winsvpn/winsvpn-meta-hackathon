@@ -0,0 +1,238 @@
+package org.winsvpn.app
+
+/**
+ * The one inner packet a winn/3 client must emit before it can be promoted, and
+ * the reason it cannot come from an application.
+ *
+ * ## What the promotion gate actually requires
+ *
+ * [WinnV3PromotionGate] wants `gate_state == carrying` AND `rx_packets > 0`.
+ * The first clause is the session's: `winn3/driver`'s `syncGate` opens the gate
+ * when `session.State()` reaches established, which is a handshake and needs no
+ * inner traffic at all. The second clause is the one that stalls, and it stalls
+ * for TWO independent reasons — both of which this probe answers and neither of
+ * which any amount of waiting fixes:
+ *
+ *  1. **The gateway has no return route yet.** `cmd/winn3-gateway`'s
+ *     `gatewayForwardDevice.WritePacket` calls `forwardTable.learn(src, loop)`
+ *     on the FIRST authenticated inner packet of the session and never before.
+ *     Until that fires, the shared kernel tun's return pump has no session to
+ *     hand a reply to, so nothing can ever come back — there is no route to
+ *     this client, and the gateway is the only party that could create one.
+ *  2. **`RxPackets` is not reported at all until the host device has spoken.**
+ *     `winn3/tun.Stats()` reports `RxPackets` as zero unless `DeviceProven` is
+ *     true, and `DeviceProven` is `DeviceReads > 0` — a packet having come OUT
+ *     of the host device. On Android the "device" is the frame channel
+ *     (`winn3FrameDevice`), so `DeviceReads` only moves when the host writes an
+ *     `OpInbound` frame. A session that received a gateway packet before the
+ *     host had ever sent one would still report `rx_packets: 0`.
+ *
+ * So the client must transmit first, and the engine has nothing that does it:
+ * the session's silence timer carries frame-level keepalives, which the gateway
+ * consumes at the frame layer and never presents to its inner side, so they
+ * teach the forwarding table nothing and move neither counter.
+ *
+ * ## Why an application cannot supply it on this platform
+ *
+ * `startWinnV3EngineThread` establishes the BOOTSTRAP posture, which §4.1 pins
+ * to one `/32` address, at most one route and NO default route. Almost nothing
+ * on the handset routes into it, and this service's own sockets are the worst
+ * candidate of all: the carrier socket is `VpnService.protect()`ed by
+ * construction, and an `adb shell` process is a different UID that the bootstrap
+ * routes do not capture. The measured bootstrap was a human driving Chrome at
+ * `http://10.10.0.1:8080` inside the thirty-second proof window, which is not a
+ * mechanism — it is a person, and the failure when they are absent is a
+ * `RefusedNotProven` that reads exactly like censorship.
+ *
+ * ## What this builds
+ *
+ * A 28-byte ICMPv4 echo request from the session's assigned inner address to its
+ * inner next hop — the gateway's own inner address. It is the smallest thing
+ * that satisfies both clauses in one round trip, and it works against BOTH
+ * gateway inner sides this tree ships:
+ *
+ *  - `-forward` (a real Linux tun addressed `<inner>/24`): the kernel owns that
+ *    address, so it answers the echo itself. `learn` has already run by then,
+ *    because `WritePacket` learns before it writes to the descriptor.
+ *  - the reflector (`cmd/winn3-gateway/reflect.go`): mirrors ANY validated IPv4
+ *    packet with the addresses swapped, so the reply is unconditional.
+ *
+ * Either way the reply's source is the gateway's inner address and its
+ * destination is ours, which is precisely what `winn3/tun/ip.go`'s inbound rule
+ * requires (`dst` ours, `src` not ours, neither martian), so it is delivered,
+ * `RxDeviceWrites` moves, `DeviceProven` is already true from this packet's own
+ * outbound trip, and `rx_packets` reports the delivery.
+ *
+ * ## Free of Android imports, and of `InetAddress`
+ *
+ * The same rule the rest of this host follows, plus one more: `InetAddress`
+ * would resolve a non-literal, and a DNS lookup on a string that came out of a
+ * config file is a lookup this tunnel exists to prevent. The parse below accepts
+ * a dotted quad and nothing else.
+ */
+internal object WinnV3BootstrapProbe {
+
+    /** IPv4 header, no options, plus the eight-byte ICMP echo header. */
+    const val PROBE_BYTES = 28
+
+    private const val IPV4_HEADER_BYTES = 20
+    private const val ICMP_HEADER_BYTES = 8
+
+    /**
+     * The ICMP identifier every probe carries.
+     *
+     * A constant rather than a random draw: nothing correlates on it (the outer
+     * wire is `winn3/core` transport, so this byte pair is inside the AEAD), the
+     * builder stays deterministic under unit test, and the sequence number is
+     * what makes each probe distinct in a capture.
+     */
+    const val IDENTIFIER = 0x7733
+
+    private const val ICMP_TYPE_ECHO_REQUEST = 8
+    private const val IP_PROTO_ICMP = 1
+
+    /**
+     * TTL 64, the Linux default.
+     *
+     * It has to be non-zero — `winn3/tun`'s parser refuses a zero TTL outright —
+     * and it has to look like everything else the host emits, because a probe
+     * with a distinctive TTL would be the one packet in the session that
+     * fingerprints the client. 64 is what the rest of the handset sends.
+     */
+    private const val TTL = 64
+
+    /** Don't-fragment. A 28-byte probe is never fragmented; saying so is free. */
+    private const val FLAG_DONT_FRAGMENT = 0x40
+
+    /**
+     * Builds one echo request, or null when this configuration cannot have one.
+     *
+     * Null rather than a thrown exception and rather than a best-effort packet:
+     * the caller's correct response is to log that the deterministic bootstrap
+     * is unavailable and let the staged start run exactly as it did before this
+     * file existed. A malformed probe would be worse than none — it would spend
+     * the session's first packet on something `winn3/tun`'s outbound validator
+     * counts as `TxDroppedInvalid`, which is the one outcome that teaches the
+     * gateway nothing while looking like it should have.
+     *
+     * @param source the session's assigned inner address (`[winn] inner_v4`).
+     *   The outbound rule is an equality against exactly this address.
+     * @param destination the inner next hop (`[winn] inner_router_v4`).
+     * @param sequence the ICMP sequence number; the caller counts probes.
+     */
+    fun echoRequest(
+        source: String,
+        destination: String,
+        sequence: Int,
+        identifier: Int = IDENTIFIER,
+    ): ByteArray? {
+        val src = parseIpv4(source) ?: return null
+        val dst = parseIpv4(destination) ?: return null
+        // Every clause winn3/tun/ip.go's outbound rule would apply, applied here
+        // instead, so a refusal is a log line on this side of the seam rather
+        // than a counter on the other side of it.
+        if (!isCarriable(src) || !isCarriable(dst)) return null
+        if (src.contentEquals(dst)) {
+            // ErrMartian, "destination is this endpoint's own inner address".
+            return null
+        }
+
+        val p = ByteArray(PROBE_BYTES)
+        p[0] = 0x45                                   // IPv4, IHL 5 (no options)
+        p[1] = 0x00                                   // no DSCP, no ECN
+        writeU16(p, 2, PROBE_BYTES)                   // total length
+        writeU16(p, 4, 0)                             // identification
+        p[6] = FLAG_DONT_FRAGMENT.toByte()            // DF, fragment offset 0
+        p[7] = 0x00
+        p[8] = TTL.toByte()
+        p[9] = IP_PROTO_ICMP.toByte()
+        writeU16(p, 10, 0)                            // checksum, filled below
+        src.copyInto(p, 12)
+        dst.copyInto(p, 16)
+        writeU16(p, 10, checksum(p, 0, IPV4_HEADER_BYTES))
+
+        p[IPV4_HEADER_BYTES] = ICMP_TYPE_ECHO_REQUEST.toByte()
+        p[IPV4_HEADER_BYTES + 1] = 0x00               // code
+        writeU16(p, IPV4_HEADER_BYTES + 2, 0)         // checksum, filled below
+        writeU16(p, IPV4_HEADER_BYTES + 4, identifier and 0xFFFF)
+        writeU16(p, IPV4_HEADER_BYTES + 6, sequence and 0xFFFF)
+        writeU16(
+            p,
+            IPV4_HEADER_BYTES + 2,
+            checksum(p, IPV4_HEADER_BYTES, IPV4_HEADER_BYTES + ICMP_HEADER_BYTES),
+        )
+        return p
+    }
+
+    /**
+     * Parses a dotted quad, or null.
+     *
+     * A trailing `/nn` is tolerated because the same strings travel through this
+     * host as bare literals and as prefixes depending on which config wrote
+     * them. A leading zero is refused: `010` is ten to this parser and eight to
+     * an octal one, and an address that means two things is not an address.
+     */
+    fun parseIpv4(text: String): ByteArray? {
+        val bare = text.substringBefore('/').trim()
+        if (bare.isEmpty()) return null
+        val parts = bare.split('.')
+        if (parts.size != 4) return null
+        val out = ByteArray(4)
+        for (i in 0..3) {
+            val part = parts[i]
+            if (part.isEmpty() || part.length > 3) return null
+            if (part.length > 1 && part[0] == '0') return null
+            var value = 0
+            for (c in part) {
+                if (c < '0' || c > '9') return null
+                value = value * 10 + (c - '0')
+            }
+            if (value > 255) return null
+            out[i] = value.toByte()
+        }
+        return out
+    }
+
+    /**
+     * The IPv4 clauses of `winn3/tun/ip.go`'s `martianReason`, mirrored.
+     *
+     * Mirrored and not approximated: unspecified, the reserved leading-zero
+     * block, loopback, multicast and above, and link-local unicast. A tunnel
+     * that will not carry the address is a tunnel this probe must not build for.
+     */
+    private fun isCarriable(a: ByteArray): Boolean {
+        val b0 = a[0].toInt() and 0xFF
+        val b1 = a[1].toInt() and 0xFF
+        if (b0 == 0) return false            // unspecified, and the reserved 0/8
+        if (b0 == 127) return false          // loopback
+        if (b0 >= 224) return false          // multicast, reserved high, broadcast
+        if (b0 == 169 && b1 == 254) return false // link-local unicast
+        return true
+    }
+
+    private fun writeU16(b: ByteArray, at: Int, value: Int) {
+        b[at] = ((value shr 8) and 0xFF).toByte()
+        b[at + 1] = (value and 0xFF).toByte()
+    }
+
+    /**
+     * The 16-bit one's complement of the one's complement sum, over `[from,
+     * until)` with that range's own checksum field already zeroed.
+     *
+     * The same routine `winn3/tun/ip.go`'s `checksum` is, deliberately: the
+     * engine verifies the IPv4 header with it and refuses `ErrBadChecksum`, so a
+     * second implementation that disagreed on the fold or on an odd tail would
+     * produce a probe the engine drops.
+     */
+    fun checksum(b: ByteArray, from: Int, until: Int): Int {
+        var sum = 0L
+        var i = from
+        while (i + 1 < until) {
+            sum += (((b[i].toInt() and 0xFF) shl 8) or (b[i + 1].toInt() and 0xFF)).toLong()
+            i += 2
+        }
+        if (i < until) sum += ((b[i].toInt() and 0xFF) shl 8).toLong()
+        while ((sum shr 16) != 0L) sum = (sum and 0xFFFF) + (sum shr 16)
+        return (sum.inv() and 0xFFFF).toInt()
+    }
+}
