+package org.winsvpn.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * The bootstrap probe, checked against the rules the ENGINE applies to it.
+ *
+ * These tests are written from `winn3/tun/ip.go` rather than from the builder:
+ * `parseIPv4` refuses a bad IHL, a total length that disagrees with the buffer,
+ * a set reserved flag bit, a zero TTL and — the one that would be silent — a
+ * header whose checksum does not verify to zero. A probe that fails any of them
+ * is counted `TxDroppedInvalid` inside the engine and teaches the gateway
+ * nothing, which is indistinguishable in a log from the bug this probe exists to
+ * fix. So the shape is asserted here, on a plain JVM, and not on a handset.
+ */
+class WinnV3BootstrapProbeTest {
+
+    private val source = "10.10.0.5"
+    private val target = "10.10.0.1"
+
+    private fun probe(sequence: Int = 1) =
+        WinnV3BootstrapProbe.echoRequest(source, target, sequence)
+
+    @Test
+    fun `the probe is a well formed 28 byte ICMPv4 echo request`() {
+        val built = probe()
+        assertNotNull(built)
+        val p = built!!
+        assertEquals(WinnV3BootstrapProbe.PROBE_BYTES, p.size)
+        assertEquals(28, p.size)
+        // Version 4, IHL 5: parseIPv4 refuses anything else at 28 bytes.
+        assertEquals(0x45, p[0].toInt() and 0xFF)
+        // Total length must equal what is present, or ErrBadHeader.
+        assertEquals(28, u16(p, 2))
+        // Bit 15 of the flags word is reserved and MUST be zero — ip.go calls it
+        // "one of the few places a deliberately malformed packet announces
+        // itself". DF may be set; the reserved bit may not.
+        assertEquals(0, p[6].toInt() and 0x80)
+        // A zero TTL is ErrBadHeader.
+        assertTrue((p[8].toInt() and 0xFF) > 0)
+        assertEquals(1, p[9].toInt() and 0xFF) // ICMP
+        assertEquals(8, p[20].toInt() and 0xFF) // echo request
+        assertEquals(0, p[21].toInt() and 0xFF) // code 0
+    }
+
+    @Test
+    fun `both checksums verify to zero the way the engine verifies them`() {
+        val p = probe()!!
+        // ip.go: "Applied to a buffer that already carries its correct checksum
+        // it returns 0, which is how verification is done here". Both ranges.
+        assertEquals(0, WinnV3BootstrapProbe.checksum(p, 0, 20))
+        assertEquals(0, WinnV3BootstrapProbe.checksum(p, 20, 28))
+    }
+
+    @Test
+    fun `the addresses are the ones the outbound rule requires`() {
+        val p = probe()!!
+        assertEquals(source, dotted(p, 12))
+        assertEquals(target, dotted(p, 16))
+    }
+
+    @Test
+    fun `the sequence number varies and the checksum tracks it`() {
+        val first = probe(1)!!
+        val second = probe(2)!!
+        assertEquals(1, u16(first, 26))
+        assertEquals(2, u16(second, 26))
+        assertEquals(WinnV3BootstrapProbe.IDENTIFIER, u16(first, 24))
+        assertEquals(WinnV3BootstrapProbe.IDENTIFIER, u16(second, 24))
+        // The whole point of recomputing: a builder that stamped a constant ICMP
+        // checksum would pass the test above and fail on every probe but one.
+        assertEquals(0, WinnV3BootstrapProbe.checksum(second, 20, 28))
+    }
+
+    @Test
+    fun `a destination equal to the assignment is refused`() {
+        // ip.go outbound: dst == ours is ErrMartian, "destination is this
+        // endpoint's own inner address".
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, source, 1))
+    }
+
+    @Test
+    fun `martian addresses are refused rather than built`() {
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "127.0.0.1", 1))
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "224.0.0.1", 1))
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "240.0.0.1", 1))
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "169.254.1.1", 1))
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "0.0.0.0", 1))
+        assertNull(WinnV3BootstrapProbe.echoRequest("0.0.0.0", target, 1))
+    }
+
+    @Test
+    fun `only a dotted quad parses`() {
+        assertNull(WinnV3BootstrapProbe.parseIpv4(""))
+        assertNull(WinnV3BootstrapProbe.parseIpv4("10.10.0"))
+        assertNull(WinnV3BootstrapProbe.parseIpv4("10.10.0.1.1"))
+        assertNull(WinnV3BootstrapProbe.parseIpv4("10.10.0.256"))
+        assertNull(WinnV3BootstrapProbe.parseIpv4("fd00::1"))
+        assertNull(WinnV3BootstrapProbe.parseIpv4("gateway.example"))
+        // A leading zero means two different numbers to two different parsers.
+        assertNull(WinnV3BootstrapProbe.parseIpv4("10.10.0.010"))
+        // A prefix suffix is tolerated: the same strings travel through this host
+        // bare and with a length depending on which config wrote them.
+        assertEquals("10.10.0.1", WinnV3BootstrapProbe.parseIpv4("10.10.0.1/32")?.let { bytes ->
+            bytes.joinToString(".") { (it.toInt() and 0xFF).toString() }
+        })
+    }
+
+    @Test
+    fun `an IPv6 next hop yields no probe rather than a broken one`() {
+        assertNull(WinnV3BootstrapProbe.echoRequest(source, "fd00::1", 1))
+    }
+
+    private fun u16(b: ByteArray, at: Int): Int =
+        ((b[at].toInt() and 0xFF) shl 8) or (b[at + 1].toInt() and 0xFF)
+
+    private fun dotted(b: ByteArray, at: Int): String =
+        (0..3).joinToString(".") { (b[at + it].toInt() and 0xFF).toString() }
+}
