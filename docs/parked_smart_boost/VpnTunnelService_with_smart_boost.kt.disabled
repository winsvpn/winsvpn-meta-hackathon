            private const val METRICS_LOG_INTERVAL_MS = 5_000L
            private const val PROBE_INTERVAL_MS = 3_000L
            private const val PROBE_BYTES = 8_000_000
            private const val PROBE_CHUNK_BYTES = 1152
            private const val PROBE_RATE_SAMPLE_MIN_BYTES = 256_000L
            private const val PROBE_RATE_SAMPLE_MIN_MS = 20L
            private const val CLIENT_FEATURE_BATCH_TX = 1
            private const val CLIENT_FEATURE_MAGIC = 0x57424631

            private fun nowMs(): Long = System.nanoTime() / 1_000_000

            private fun burstPacketsForPath(pathId: Int): Int {
                return if (pathId == WIFI_PATH_ID || isWifiSubpathId(pathId)) {
                    WIFI_BURST_PACKETS
                } else {
                    SECONDARY_BURST_PACKETS
                }
            }

            private fun isWifiSubpathId(pathId: Int): Boolean {
                return pathId in WIFI_SUBPATH_BASE_ID until (WIFI_SUBPATH_BASE_ID + WIFI_SUBPATH_COUNT)
            }

            private fun transportName(transport: Int): String {
                return when (transport) {
                    NetworkCapabilities.TRANSPORT_WIFI -> "Wi-Fi"
                    NetworkCapabilities.TRANSPORT_CELLULAR -> "cellular"
                    else -> "transport-$transport"
                }
            }

            private fun decodeKey(text: String): ByteArray {
                return try {
                    val decoded = Base64.decode(text, Base64.DEFAULT)
                    if (decoded.size == 16 || decoded.size == 24 || decoded.size == 32) {
                        decoded
                    } else {
                        MessageDigest.getInstance("SHA-256").digest(text.toByteArray(Charsets.UTF_8))
                    }
                } catch (_: Exception) {
                    MessageDigest.getInstance("SHA-256").digest(text.toByteArray(Charsets.UTF_8))
                }
            }

            private fun parseEndpoint(endpoint: String, defaultPort: Int): InetSocketAddress {
                val trimmed = endpoint.trim()
                val idx = trimmed.lastIndexOf(':')
                val host = if (idx > 0) trimmed.substring(0, idx).trim().trim('[', ']') else trimmed
                val port = if (idx > 0) {
                    trimmed.substring(idx + 1).toIntOrNull() ?: defaultPort
                } else {
                    defaultPort
                }
                require(host.isNotBlank()) { "Smart Boost endpoint host missing" }
                return InetSocketAddress(host, port)
            }

            private fun ipv4Bytes(value: String): ByteArray {
                val parts = value.split(".").mapNotNull { it.toIntOrNull() }
                if (parts.size != 4 || parts.any { it !in 0..255 }) {
                    return byteArrayOf(10, 88, 0, 2)
                }
                return byteArrayOf(
                    parts[0].toByte(),
                    parts[1].toByte(),
                    parts[2].toByte(),
                    parts[3].toByte(),
                )
            }

            private fun ipv4U32(packet: ByteArray, offset: Int): Long {
                return ((packet[offset].toLong() and 0xFF) shl 24) or
                    ((packet[offset + 1].toLong() and 0xFF) shl 16) or
                    ((packet[offset + 2].toLong() and 0xFF) shl 8) or
                    (packet[offset + 3].toLong() and 0xFF)
            }

            private fun u16(packet: ByteArray, offset: Int): Int {
                return ((packet[offset].toInt() and 0xFF) shl 8) or
                    (packet[offset + 1].toInt() and 0xFF)
            }

            private fun putLongBE(target: ByteArray, offset: Int, value: Long) {
                target[offset] = (value ushr 56).toByte()
                target[offset + 1] = (value ushr 48).toByte()
                target[offset + 2] = (value ushr 40).toByte()
                target[offset + 3] = (value ushr 32).toByte()
                target[offset + 4] = (value ushr 24).toByte()
                target[offset + 5] = (value ushr 16).toByte()
                target[offset + 6] = (value ushr 8).toByte()
                target[offset + 7] = value.toByte()
            }

            private fun putU16(target: ByteArray, offset: Int, value: Int) {
                target[offset] = ((value ushr 8) and 0xFF).toByte()
                target[offset + 1] = (value and 0xFF).toByte()
            }

            private fun readLongBE(source: ByteArray, offset: Int): Long {
                return ((source[offset].toLong() and 0xFF) shl 56) or
                    ((source[offset + 1].toLong() and 0xFF) shl 48) or
                    ((source[offset + 2].toLong() and 0xFF) shl 40) or
                    ((source[offset + 3].toLong() and 0xFF) shl 32) or
                    ((source[offset + 4].toLong() and 0xFF) shl 24) or
                    ((source[offset + 5].toLong() and 0xFF) shl 16) or
                    ((source[offset + 6].toLong() and 0xFF) shl 8) or
                    (source[offset + 7].toLong() and 0xFF)
            }
        }
    }

    private fun parseConfigValue(config: String?, key: String): String? {
        if (config == null) return null
        val lines = config.split("\n")
        var currentSection = ""
        for (line in lines) {
            val trimmedLine = line.trim()
            if (trimmedLine.startsWith("[") && trimmedLine.endsWith("]")) {
                currentSection = trimmedLine.lowercase()
                continue
            }

            val isCorrectSection = when (key.lowercase()) {
                "address", "dns", "mtu", "privatekey", "jc", "jmin", "jmax", "s1", "s2", "s3", "s4", "h1", "h2", "h3", "h4" -> currentSection == "[interface]"
                "publickey", "presharedkey", "endpoint", "allowedips", "persistentkeepalive" -> currentSection == "[peer]"
                else -> true
            }

            if (isCorrectSection && trimmedLine.startsWith(key, ignoreCase = true)) {
                val parts = trimmedLine.split("=", limit = 2)
                if (parts.size > 1) return parts[1].trim()
            }
        }
        return null
    }

    private fun parseConfigSection(config: String, sectionName: String): Map<String, String> {
        val out = linkedMapOf<String, String>()
        var inSection = false
        for (line in config.split("\n")) {
            val trimmed = line.trim()
            if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
                inSection = trimmed.removePrefix("[").removeSuffix("]").equals(sectionName, ignoreCase = true)
                continue
            }
            if (inSection && trimmed.contains("=")) {
                val parts = trimmed.split("=", limit = 2)
                out[parts[0].trim().lowercase()] = parts[1].trim()
            }
        }
        return out
    }

    private fun stripConfigSection(config: String, sectionName: String): String {
        val out = StringBuilder()
        var skip = false
        for (line in config.split("\n")) {
            val trimmed = line.trim()
            if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
                skip = trimmed.removePrefix("[").removeSuffix("]").equals(sectionName, ignoreCase = true)
            }
            if (!skip) out.append(line).append('\n')
        }
        return out.toString().trim()
    }

    private fun parseBool(value: String?): Boolean {
        val v = value?.trim()?.lowercase() ?: return false
        return v == "true" || v == "1" || v == "yes" || v == "y"
    }

    private fun keyFingerprint(value: String): String {
        if (value.isBlank()) return "missing"
        return try {
            val digest = MessageDigest.getInstance("SHA-256").digest(value.toByteArray(Charsets.UTF_8))
            digest.take(8).joinToString("") { "%02x".format(it) }
        } catch (_: Exception) {
            "unavailable"
        }
    }
}
