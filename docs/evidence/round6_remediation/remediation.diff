+def validated_btcpay_checkout_url(raw_url: str) -> str:
+    """Bind checkout navigation to the configured HTTPS origin."""
+    def normalized_url(value: str):
+        if not isinstance(value, str) or not value or re.search(r"[\x00-\x20\x7f\\]", value):
+            raise ValueError("BTCPay URL is missing or contains forbidden characters")
+        parsed = urllib.parse.urlsplit(value)
+        if parsed.scheme != "https" or not parsed.netloc:
+            raise ValueError("BTCPay URL must use HTTPS")
+        if parsed.username is not None or parsed.password is not None:
+            raise ValueError("BTCPay URL must not contain user information")
+        if not re.fullmatch(r"(?:\[[0-9A-Fa-f:.]+\]|[^:\[\]]+)(?::[0-9]+)?", parsed.netloc):
+            raise ValueError("BTCPay URL has a malformed authority")
+        hostname = parsed.hostname
+        if not hostname or "%" in hostname:
+            raise ValueError("BTCPay URL has an invalid hostname")
+        if ":" in hostname:
+            hostname = ipaddress.IPv6Address(hostname).compressed
+            authority = f"[{hostname}]"
+        else:
+            hostname = hostname.encode("idna").decode("ascii").lower().removesuffix(".")
+            if len(hostname) > 253 or not all(
+                re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label)
+                for label in hostname.split(".")
+            ):
+                raise ValueError("BTCPay URL has an invalid hostname")
+            authority = hostname
+        port = parsed.port if parsed.port is not None else 443
+        if port < 1:
+            raise ValueError("BTCPay URL has an invalid port")
+        if port != 443:
+            authority += f":{port}"
+        return parsed._replace(netloc=authority), ("https", hostname, port)
+
+    checkout, checkout_origin = normalized_url(raw_url)
+    _, configured_origin = normalized_url(BTCPAY_URL)
+    if checkout_origin != configured_origin:
+        raise ValueError("BTCPay checkout URL origin does not match BTCPAY_URL")
+    return checkout.geturl()
