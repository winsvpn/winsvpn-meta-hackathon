+def acquire_double_vpn_enrollment_lease(
+    conn: sqlite3.Connection,
+    account_number: str,
+    device_id: str,
+) -> str:
+    now = time.time()
+    ttl_seconds = max(
+        60,
+        DOUBLE_VPN_ASSIGNMENT_READY_TIMEOUT_SECONDS + 30,
+    )
+    conn.execute(
+        "DELETE FROM double_vpn_enrollment_leases WHERE expires_at <= ?",
+        (now,),
+    )
+    lease_token = secrets.token_urlsafe(32)
+    try:
+        conn.execute(
+            """
+            INSERT INTO double_vpn_enrollment_leases (
+                account_number, device_id, lease_token, expires_at, created_at
+            ) VALUES (?, ?, ?, ?, ?)
+            """,
+            (
+                account_number,
+                device_id,
+                lease_token,
+                now + ttl_seconds,
+                utcnow().isoformat(),
+            ),
+        )
+    except sqlite3.IntegrityError as exc:
+        raise HTTPException(
+            status_code=409,
+            detail="A Double VPN enrollment is already being prepared for this account.",
+            headers={
+                "X-Wins-Error-Code": "double_vpn_enrollment_in_flight",
+                "Retry-After": "5",
+            },
+        ) from exc
+    return lease_token
+
+
+def release_double_vpn_enrollment_lease(
+    account_number: str,
+    lease_token: str,
+) -> None:
+    try:
+        with get_db() as cleanup_conn:
+            cleanup_conn.execute("BEGIN IMMEDIATE")
+            cleanup_conn.execute(
+                "DELETE FROM double_vpn_enrollment_leases "
+                "WHERE account_number = ? AND lease_token = ?",
+                (account_number, lease_token),
+            )
+    except sqlite3.Error:
+        logger.exception(
+            "Double VPN enrollment lease cleanup failed for account_hash=%s",
+            security_event_hash(account_number),
+        )
+
