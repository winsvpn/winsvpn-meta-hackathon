+// Advance only the refresh cadence, leaving expiration on the real clock.
+func dueAuthorityRefresh(r *peerRegistry) {
+	r.refreshMu.Lock()
+	r.lastCheck = time.Now().Add(-2 * time.Second)
+	r.refreshMu.Unlock()
+}
