+int OpenFdCount() {
+  DIR* directory = opendir("/proc/self/fd");
+  Require(directory != nullptr, "cannot count descriptors");
+  int count = 0;
+  while (readdir(directory)) ++count;
+  closedir(directory);
+  return count;
