+func replaceAuthority(t *testing.T, path, body string) {
+	t.Helper()
+	replacement := path + ".new"
+	if err := os.WriteFile(replacement, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(replacement, path); err != nil {
+		t.Fatal(err)
+	}
+}
