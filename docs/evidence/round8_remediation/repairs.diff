+def create_winn3_registry_refresh_table(conn: sqlite3.Connection):
+    existed = table_exists(conn, "winn3_registry_refreshes")
+    conn.execute("""
+        CREATE TABLE IF NOT EXISTS winn3_registry_refreshes (
+            node_slug TEXT PRIMARY KEY,
+            attempts INTEGER NOT NULL DEFAULT 0,
+            next_attempt_at REAL NOT NULL DEFAULT 0
+        )
+    """)
+    for event, records in (
+        ("INSERT", ("NEW",)),
+        ("DELETE", ("OLD",)),
+        ("UPDATE OF location_slug, winn3_static_public, winn3_inner_v4", ("OLD", "NEW")),
+    ):
+        trigger_name = "winn3_registry_devices_" + event.split()[0].lower()
+        statements = []
+        for record in records:
+            statements.append(f"""
+                INSERT INTO winn3_registry_refreshes (node_slug, attempts, next_attempt_at)
+                SELECT {record}.location_slug, 0, 0
+                WHERE COALESCE({record}.winn3_static_public, '') != ''
+                  AND COALESCE({record}.location_slug, '') != ''
+                ON CONFLICT(node_slug) DO UPDATE SET attempts=0, next_attempt_at=0;
+            """)
+        conn.execute(
+            f"CREATE TRIGGER IF NOT EXISTS {trigger_name} AFTER {event} ON devices "
+            "BEGIN " + " ".join(statements) + " END"
+        )
+    conn.execute("""
+        CREATE TRIGGER IF NOT EXISTS winn3_registry_account_authority
+        AFTER UPDATE OF status, expiration_date ON users
+        BEGIN
+            INSERT INTO winn3_registry_refreshes (node_slug, attempts, next_attempt_at)
+            SELECT DISTINCT location_slug, 0, 0 FROM devices
+            WHERE account_number=NEW.account_number
+              AND COALESCE(winn3_static_public, '') != ''
+              AND COALESCE(location_slug, '') != ''
+            ON CONFLICT(node_slug) DO UPDATE SET attempts=0, next_attempt_at=0;
+        END
+    """)
+    if not existed:
+        # Reconcile registered v3 nodes when this durable queue first exists.
+        conn.execute("""
+            INSERT OR IGNORE INTO winn3_registry_refreshes (node_slug)
+            SELECT slug FROM nodes WHERE protocol_version='winn/3' AND slug != ''
+        """)
+
+
+def drain_winn3_registry_refreshes(limit: int = 4) -> dict:
+    published = 0
+    retry = 0
+    with get_db() as conn:
+        ensure_schema(conn)
+        pending = conn.execute(
+            "SELECT node_slug FROM winn3_registry_refreshes WHERE next_attempt_at<=? "
+            "ORDER BY next_attempt_at, node_slug LIMIT ?",
+            (time.time(), max(1, min(int(limit), 32))),
+        ).fetchall()
+    for item in pending:
+        with get_db() as conn:
+            conn.execute("BEGIN IMMEDIATE")
+            queued = conn.execute(
+                "SELECT attempts FROM winn3_registry_refreshes "
+                "WHERE node_slug=? AND next_attempt_at<=?",
+                (item["node_slug"], time.time()),
+            ).fetchone()
+            if queued is None:
+                continue
+            node = conn.execute(
+                "SELECT ssh_host, endpoint FROM nodes WHERE slug=?", (item["node_slug"],)
+            ).fetchone()
+            node_ip = (node["ssh_host"] or extract_node_host(node["endpoint"] or "")) if node else ""
+            if node_ip and sync_winn3_registry_to_node(conn, node_ip, item["node_slug"]):
+                conn.execute("DELETE FROM winn3_registry_refreshes WHERE node_slug=?", (item["node_slug"],))
+                published += 1
+            else:
+                attempts = int(queued["attempts"]) + 1
+                conn.execute(
+                    "UPDATE winn3_registry_refreshes SET attempts=?, next_attempt_at=? WHERE node_slug=?",
+                    (attempts, time.time() + peer_revocation_backoff_seconds(attempts), item["node_slug"]),
+                )
+                retry += 1
+    return {"published": published, "retry": retry}
+
