+def verify_advisory_request_authorized(
+    conn: sqlite3.Connection,
+    *,
+    account_number: str,
+    requested_client_public_key: str,
+    request: Request,
+) -> bool:
+    bearer = bearer_token_from_request(request)
+    if bearer:
+        rows = conn.execute(
+            "SELECT device_auth_token_hash FROM devices "
+            "WHERE account_number = ? AND client_public_key = ?",
+            (account_number, requested_client_public_key),
+        ).fetchall()
+        if any(device_auth_token_matches(row["device_auth_token_hash"], bearer) for row in rows):
+            return True
+    presented = request.headers.get("x-wins-activation", "").strip()
+    if not presented:
+        return False
+    row = conn.execute(
+        "SELECT activation_secret_hash, activation_secret_expires_at, activation_secret_used_at "
+        "FROM users WHERE account_number = ?", (account_number,),
+    ).fetchone()
+    if row is None or row["activation_secret_used_at"] is not None:
+        return False
+    if row["activation_secret_expires_at"]:
+        expires = parse_iso_datetime(row["activation_secret_expires_at"])
+        if expires is None or expires <= now_utc():
+            return False
+    return activation_secret_matches(row["activation_secret_hash"], presented)
+
