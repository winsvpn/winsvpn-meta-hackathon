+def _activation_outbox_keys() -> tuple[bytes, bytes]:
+    root = hmac.new(_ACTIVATION_SECRET_PEPPER, b"wins-activation-outbox-root/v1", hashlib.sha256).digest()
+    return (
+        hmac.new(root, b"enc/v1", hashlib.sha256).digest(),
+        hmac.new(root, b"mac/v1", hashlib.sha256).digest(),
+    )
+
+
+def _activation_outbox_stream(key: bytes, nonce: bytes, length: int) -> bytes:
+    output = bytearray()
+    for counter in range((length + 31) // 32):
+        output.extend(hmac.new(key, nonce + counter.to_bytes(8, "big"), hashlib.sha256).digest())
+    return bytes(output[:length])
+
+
+def _activation_outbox_aad(delivery_id: str, account_number: str) -> bytes:
+    return json.dumps([delivery_id, account_number], separators=(",", ":")).encode("utf-8")
+
+
+def seal_activation_delivery(secret: str, delivery_id: str, account_number: str) -> str:
+    # Encrypt-then-MAC with independent HMAC-SHA256 keys and a random nonce.
+    # This uses the same stdlib PRF construction as the prepaid outbox, with
+    # distinct keys and framing. HMAC alone would not conceal the credential.
+    plaintext = secret.encode("utf-8")
+    if not 1 <= len(plaintext) <= 256:
+        raise ValueError("invalid activation delivery secret length")
+    enc_key, mac_key = _activation_outbox_keys()
+    nonce = secrets.token_bytes(32)
+    stream = _activation_outbox_stream(enc_key, nonce, len(plaintext))
+    ciphertext = bytes(left ^ right for left, right in zip(plaintext, stream))
+    aad = _activation_outbox_aad(delivery_id, account_number)
+    tag = hmac.new(mac_key, b"wao1|" + aad + b"|" + nonce + ciphertext, hashlib.sha256).digest()
+    return "wao1|" + "|".join(base64.b64encode(value).decode("ascii") for value in (nonce, ciphertext, tag))
+
+
+def open_activation_delivery(sealed: str, delivery_id: str, account_number: str) -> str:
+    if not isinstance(sealed, str) or len(sealed) > 512:
+        raise ValueError("invalid activation delivery envelope")
+    parts = sealed.split("|")
+    if len(parts) != 4 or parts[0] != "wao1":
+        raise ValueError("invalid activation delivery envelope")
+    try:
+        nonce, ciphertext, tag = (base64.b64decode(value, validate=True) for value in parts[1:])
+    except (ValueError, TypeError) as exc:
+        raise ValueError("malformed activation delivery envelope") from exc
+    if len(nonce) != 32 or len(tag) != 32 or not 1 <= len(ciphertext) <= 256:
+        raise ValueError("invalid activation delivery envelope lengths")
+    enc_key, mac_key = _activation_outbox_keys()
+    aad = _activation_outbox_aad(delivery_id, account_number)
+    expected = hmac.new(mac_key, b"wao1|" + aad + b"|" + nonce + ciphertext, hashlib.sha256).digest()
+    if not hmac.compare_digest(expected, tag):
+        raise ValueError("activation delivery authentication failed")
+    stream = _activation_outbox_stream(enc_key, nonce, len(ciphertext))
+    return bytes(left ^ right for left, right in zip(ciphertext, stream)).decode("utf-8")
+
+
+def enqueue_activation_delivery(
+    conn: sqlite3.Connection, delivery_id: str, target_email: str,
+    subscriber_name: str, account_number: str, plan_type: str, activation_secret: str,
+) -> None:
+    # No commit here: granting access, event completion and delivery are atomic.
+    now = utcnow().isoformat()
+    conn.execute("""
+        INSERT INTO activation_delivery_outbox (
+            delivery_id, account_number, target_email, subscriber_name,
+            plan_type, sealed_secret, next_attempt_at, created_at
+        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+    """, (
+        delivery_id, account_number, target_email.strip().lower(),
+        subscriber_name or "Wins VPN User", plan_type,
+        seal_activation_delivery(activation_secret, delivery_id, account_number), now, now,
+    ))
+
+
+def claim_activation_delivery_batch(limit: int = 20) -> list[dict]:
+    now = utcnow()
+    now_text = now.isoformat()
+    claimed = []
+    with get_db() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        rows = conn.execute("""
+            SELECT * FROM activation_delivery_outbox
+            WHERE (status IN ('pending', 'failed') OR (status='sending' AND lease_until <= ?))
+              AND next_attempt_at <= ? AND (lease_until IS NULL OR lease_until <= ?)
+            ORDER BY next_attempt_at, created_at LIMIT ?
+        """, (now_text, now_text, now_text, max(1, min(int(limit), 100)))).fetchall()
+        for row in rows:
+            item = dict(row)
+            item["lease_token"] = secrets.token_hex(16)
+            item["attempts"] += 1
+            conn.execute("""
+                UPDATE activation_delivery_outbox SET status='sending', attempts=?, lease_token=?, lease_until=?
+                WHERE delivery_id=?
+            """, (item["attempts"], item["lease_token"], (now + timedelta(minutes=5)).isoformat(), item["delivery_id"]))
+            claimed.append(item)
+    return claimed
+
+
+def finish_activation_delivery(item: dict, sent: bool, error: str = "") -> None:
+    now = utcnow()
+    delay = min(3600, 30 * (2 ** min(max(int(item["attempts"]) - 1, 0), 7)))
+    with get_db() as conn:
+        if sent:
+            conn.execute("""
+                UPDATE activation_delivery_outbox SET status='sent', sealed_secret='',
+                    lease_token=NULL, lease_until=NULL, last_error=NULL, sent_at=?
+                WHERE delivery_id=? AND status='sending' AND lease_token=?
+            """, (now.isoformat(), item["delivery_id"], item["lease_token"]))
+        else:
+            conn.execute("""
+                UPDATE activation_delivery_outbox SET status='failed', lease_token=NULL,
+                    lease_until=NULL, next_attempt_at=?, last_error=?
+                WHERE delivery_id=? AND status='sending' AND lease_token=?
+            """, ((now + timedelta(seconds=delay)).isoformat(), error[:100] or "smtp_not_accepted",
+                  item["delivery_id"], item["lease_token"]))
+
+
+def _prepare_activation_delivery(item: dict) -> Optional[str]:
+    # Revalidate custody immediately before delivery. A resend, consumption,
+    # refund or deletion must not cause an obsolete key to be emailed.
+    with get_db() as conn:
+        conn.execute("BEGIN IMMEDIATE")
+        delivery = conn.execute("""
+            SELECT sealed_secret FROM activation_delivery_outbox
+            WHERE delivery_id=? AND status='sending' AND lease_token=? AND lease_until>?
+        """, (item["delivery_id"], item["lease_token"], utcnow().isoformat())).fetchone()
+        if delivery is None:
+            return None
+        secret = open_activation_delivery(delivery["sealed_secret"], item["delivery_id"], item["account_number"])
+        user = conn.execute("""
+            SELECT status, email, expiration_date, activation_secret_hash,
+                   activation_secret_used_at, activation_secret_expires_at
+            FROM users WHERE account_number=?
+        """, (item["account_number"],)).fetchone()
+        expiry = parse_iso_datetime(user["expiration_date"]) if user else None
+        valid = (
+            user is not None and user["status"] == "active"
+            and (not user["expiration_date"] or (expiry is not None and expiry > utcnow()))
+            and str(user["email"] or "").strip().lower() == item["target_email"]
+            and user["activation_secret_used_at"] is None
+            and activation_secret_matches(user["activation_secret_hash"], secret)
+        )
+        if not valid:
+            conn.execute("""
+                UPDATE activation_delivery_outbox SET status='cancelled', sealed_secret='',
+                    lease_token=NULL, lease_until=NULL, last_error='credential_superseded_or_account_inactive'
+                WHERE delivery_id=? AND lease_token=?
+            """, (item["delivery_id"], item["lease_token"]))
+            return None
+        key_expiry = parse_iso_datetime(user["activation_secret_expires_at"])
+        if key_expiry is None or key_expiry < utcnow() + timedelta(minutes=30):
+            # Keep the same secret across ambiguous SMTP retries. Extend only
+            # the still-current, unconsumed key, under the writer lock.
+            conn.execute("UPDATE users SET activation_secret_expires_at=? WHERE account_number=?",
+                         ((utcnow() + timedelta(minutes=30)).isoformat(), item["account_number"]))
+    return secret
+
+
+def drain_activation_delivery_outbox_once() -> int:
+    sent_count = 0
+    # Claim each message just before sending, so slow SMTP cannot age a batch
+    # past its lease while another worker starts delivering the same messages.
+    for _ in range(20):
+        batch = claim_activation_delivery_batch(limit=1)
+        if not batch:
+            break
+        item = batch[0]
+        try:
+            secret = _prepare_activation_delivery(item)
+            if secret is None:
+                continue
+            sent = send_account_email(item["target_email"], item["subscriber_name"],
+                                      item["account_number"], item["plan_type"], secret)
+        except Exception as exc:
+            # Exception text may contain addresses or credentials from SMTP.
+            finish_activation_delivery(item, False, type(exc).__name__)
+            continue
+        finish_activation_delivery(item, bool(sent))
+        sent_count += int(bool(sent))
+    return sent_count
+
+
+async def activation_delivery_outbox_sweep_loop() -> None:
+    while True:
+        try:
+            await asyncio.to_thread(drain_activation_delivery_outbox_once)
+        except Exception as exc:
+            logger.error("Activation delivery outbox sweep failed: %s", type(exc).__name__)
+        await asyncio.sleep(30)
+
+
+_activation_delivery_task = None
+
+
+@app.on_event("shutdown")
+async def stop_activation_delivery_worker():
+    global _activation_delivery_task
+    if _activation_delivery_task is not None:
+        _activation_delivery_task.cancel()
+        try:
+            await _activation_delivery_task
+        except asyncio.CancelledError:
+            pass
+        _activation_delivery_task = None
+
