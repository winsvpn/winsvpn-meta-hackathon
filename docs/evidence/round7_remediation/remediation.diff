+
+class PowerInhibitionTests(unittest.TestCase):
+    def test_named_service_start_repeated_start_failure_and_stop(self):
+        source = (ROOT / "linux/runner/linux_tunnel_backend.cc").read_text()
+        start = source.index("void StartTunnelPowerProtection()")
+        end = source.index("// Atomically and safely writes", start)
+        functions = source[start:end]
+        self.assertNotIn("PowerInhibitPidFile", source)
+        self.assertNotIn("wins_vpn_power_inhibit.pid", source)
+        prefix = r'''
+#include <cassert>
+#include <string>
+#include <vector>
+enum class ProcOutput { kSuppress };
+struct ProcResult { int exit_status; };
+std::vector<std::vector<std::string>> calls;
+bool active = false;
+int start_status = 0;
+ProcResult RunArgv(const std::vector<std::string>& argv, ProcOutput) {
+  calls.push_back(argv);
+  if (argv.size() > 2 && argv[2] == "is-active") return {active ? 0 : 3};
+  if (argv[0] == "systemd-run") {
+    active = start_status == 0;
+    return {start_status};
+  }
+  assert(argv == (std::vector<std::string>{
+      "systemctl", "--user", "stop", "winsvpn-power-inhibit.service"}));
+  active = false;
+  return {0};
+}
+'''
+        suffix = r'''
+int main() {
+  StartTunnelPowerProtection();
+  assert(active && calls.size() == 2);
+  assert(calls[0] == (std::vector<std::string>{
+      "systemctl", "--user", "is-active", "--quiet", "winsvpn-power-inhibit.service"}));
+  assert(calls[1] == (std::vector<std::string>{
+      "systemd-run", "--user", "--unit=winsvpn-power-inhibit.service",
+      "--collect", "--property=Type=exec", "systemd-inhibit",
+      "--what=sleep:idle", "--why=Win's VPN active tunnel", "--mode=block",
+      "sleep", "infinity"}));
+  StartTunnelPowerProtection();
+  assert(active && calls.size() == 3);
+  StopTunnelPowerProtection();
+  assert(!active && calls.size() == 4);
+  StopTunnelPowerProtection();
+  assert(!active && calls.size() == 5);
+  start_status = 1;
+  StartTunnelPowerProtection();
+  assert(!active && calls.size() == 7);
+  start_status = 0;
+  StartTunnelPowerProtection();
+  assert(active && calls.size() == 9);
+  StopTunnelPowerProtection();
+  assert(!active);
+}
+'''
+        with tempfile.TemporaryDirectory(prefix="winsvpn-power-test-") as directory:
+            path = Path(directory)
+            (path / "test.cc").write_text(prefix + functions + suffix)
+            subprocess.run(["c++", "-std=c++17", "-Wall", "-Wextra", "-Werror",
+                            "-UNDEBUG", str(path / "test.cc"), "-o", str(path / "test")], check=True)
+            subprocess.run([str(path / "test")], check=True, timeout=10)
+
+
+if __name__ == "__main__":
