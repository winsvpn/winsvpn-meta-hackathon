// Development identities. Supply the approved identity and team when signing.
SAFARI_PROXY_BASE_ID = org.winsvpn.safariproxy
DEVELOPMENT_TEAM =
MARKETING_VERSION = 1.0.16
CURRENT_PROJECT_VERSION = 33
ENABLE_DEBUG_DYLIB = NO
SAFARI_WEB_PACKAGE = $(SRCROOT)/../../extension/dist/safari
SAFARI_ENGINE_ARCHIVE = $(SRCROOT)/Artifacts/Engine/libSafariWinn-macos-$(CURRENT_ARCH).a
SWIFT_VERSION = 5.0
MACOSX_DEPLOYMENT_TARGET = 14.0
IPHONEOS_DEPLOYMENT_TARGET = 18.0
CODE_SIGN_STYLE = Manual
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
SWIFT_EMIT_LOC_STRINGS = NO
ENABLE_HARDENED_RUNTIME = YES
