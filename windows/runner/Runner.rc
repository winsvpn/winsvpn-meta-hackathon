/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// Keep the fixed PE fields deliberately distinct. The cross-store verifier
// requires ProductVersion to be the canonical three-part marketing version
// (encoded as 1.0.17.0 in VS_FIXEDFILEINFO) and FileVersion to include the
// release build number. Do not inherit Flutter's display version here: its
// plus-delimited form is not a Windows PE version resource contract.
#define WINS_PRODUCT_VERSION_NUMBER 1,0,17,0
#define WINS_FILE_VERSION_NUMBER 1,0,17,34
#define WINS_PRODUCT_VERSION_STRING "1.0.17"
#define WINS_FILE_VERSION_STRING "1.0.17.34"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINS_FILE_VERSION_NUMBER
 PRODUCTVERSION WINS_PRODUCT_VERSION_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Win's VPN" "\0"
            VALUE "FileDescription", "Win's VPN" "\0"
            VALUE "FileVersion", WINS_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "wins_vpn" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Win's VPN. All rights reserved." "\0"
            VALUE "OriginalFilename", "wins_vpn.exe" "\0"
            VALUE "ProductName", "Win's VPN" "\0"
            VALUE "ProductVersion", WINS_PRODUCT_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

